  "embeddedChips": [
    {
      "id": "d3a42008-0000-4000-8000-000000000012",
      "definitionVersion": 1,
      "name": "74HC595",
      "description": "\u0426\u0438\u0444\u0440\u043E\u0432\u0430\u044F \u0440\u0430\u0441\u043F\u0438\u043D\u043E\u0432\u043A\u0430 74HC595. \u0420\u0435\u0433\u0438\u0441\u0442\u0440 \u0441\u0434\u0432\u0438\u0433\u0430 (SRCLK) \u0438 \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u0430\u044F \u0437\u0430\u0449\u0451\u043B\u043A\u0430 (RCLK), \u0430\u0441\u0438\u043D\u0445\u0440\u043E\u043D\u043D\u044B\u0439 SRCLR#, OE# \u0443\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442 \u0442\u043E\u043B\u044C\u043A\u043E QA\u2013QH, QH\u0027 \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F \u0430\u043A\u0442\u0438\u0432\u043D\u044B\u043C. \u0421\u043E\u0432\u043F\u0430\u0434\u0430\u044E\u0449\u0438\u0435 \u0444\u0440\u043E\u043D\u0442\u044B \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u044F\u0442 \u043F\u0440\u0435\u0436\u043D\u0435\u0435 \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435 \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0430. Setup/hold \u0438 \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u043D\u044B\u0435 \u044D\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u044B \u043D\u0435 \u043C\u043E\u0434\u0435\u043B\u0438\u0440\u0443\u044E\u0442\u0441\u044F.",
