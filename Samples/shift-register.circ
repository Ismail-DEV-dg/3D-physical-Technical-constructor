{
  "sketch": {
    "text": "// \u041E\u0431\u0449\u0438\u0439 \u0442\u0430\u043A\u0442 SRCLK/RCLK \u043D\u0430 D13. \u041D\u0430\u0436\u043C\u0438\u0442\u0435 RESET \u043F\u0435\u0440\u0435\u0434 \u0434\u0435\u043C\u043E\u043D\u0441\u0442\u0440\u0430\u0446\u0438\u0435\u0439.\nvoid setup() { pinMode(13, OUTPUT); }\nvoid loop() { digitalWrite(13, HIGH); delay(50); digitalWrite(13, LOW); delay(50); }",
    "board": "Uno",
    "name": "Example",
