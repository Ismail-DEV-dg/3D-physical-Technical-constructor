<UserControl x:Class="CircuitEditor.App.Views.CalculationResultsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:CircuitEditor.App.Views">
 <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <WrapPanel>
   <Button Content="Только в цепи" Command="{Binding ShowUsedCommand}" Tag="{Binding UsedOnly}" Style="{StaticResource ResultFilterButton}" ToolTip="Только узлы с внешними соединениями и участвующие детали"/>
   <Button Content="Все узлы и детали" Command="{Binding ShowEverythingCommand}" Tag="{Binding ShowAll}" Style="{StaticResource ResultFilterButton}" ToolTip="Все выводы деталей, включая неподключённые"/>
   <Button Content="Проблемы расчёта" Command="{Binding DataContext.ShowProblemsCommand, RelativeSource={RelativeSource AncestorType=views:EditorLayoutView}}" Style="{StaticResource ResultFilterButton}"/>
  </WrapPanel>
  <TextBlock Grid.Row="1" Text="{Binding Summary}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,8"/>
  <Grid Grid.Row="2">
   <ListBox ItemsSource="{Binding Entries}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Результаты расчёта цепи">
    <ListBox.ItemTemplate><DataTemplate>
     <StackPanel Margin="2,3">
      <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Value}" Foreground="{DynamicResource AccentBrush}" Margin="8,0,0,0" FontSize="12"/>
       <TextBlock Text="{Binding Title}" FontWeight="Bold" TextWrapping="Wrap" FontSize="11"/></DockPanel>
      <TextBlock Text="{Binding Category}" FontSize="11" Foreground="{DynamicResource PurpleBrush}" Margin="0,4,0,0"/>
      <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
     </StackPanel>
    </DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <TextBlock Text="{Binding EmptyMessage}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="8" IsHitTestVisible="False">
    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
     <DataTrigger Binding="{Binding HasEntries}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
    </Style.Triggers></Style></TextBlock.Style>
   </TextBlock>
  </Grid>
 </Grid>
</UserControl>
