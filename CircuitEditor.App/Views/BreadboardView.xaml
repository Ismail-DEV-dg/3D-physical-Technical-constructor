<UserControl x:Class="CircuitEditor.App.Views.BreadboardView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:CircuitEditor.App.Views"
 xmlns:controls="clr-namespace:CircuitEditor.App.Controls"
 xmlns:converters="clr-namespace:CircuitEditor.App.Converters"
 xmlns:input="clr-namespace:CircuitEditor.App.Interaction">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleIf"/>
        <converters:ToolbarLabelVisibilityConverter x:Key="ToolbarLabelVisibility"/>
        <Style x:Key="ToolRailButton" TargetType="Button" BasedOn="{StaticResource QuietAction}">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ToolRailMarker" TargetType="Border">
            <Setter Property="Width" Value="2"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="CornerRadius" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style x:Key="ToolRailSymbol" TargetType="Path">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"/>
            <Setter Property="StrokeThickness" Value="1.5"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
        </Style>
        <Style x:Key="CanvasAction" TargetType="Button" BasedOn="{StaticResource QuietAction}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="7,0"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style x:Key="CanvasToggle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="7,0"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style x:Key="CanvasToggleIcon" TargetType="Path">
            <Setter Property="Width" Value="13"/>
            <Setter Property="Height" Value="13"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
            <Setter Property="StrokeThickness" Value="1.4"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>
        <Style x:Key="ToolRailToggle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Frame" CornerRadius="6" BorderThickness="1" BorderBrush="Transparent" Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Style="{StaticResource ToolRailMarker}" IsHitTestVisible="False"
                                    Visibility="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource VisibleIf}}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="52"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource SubtleLineBrush}"
                BorderThickness="1" Margin="0,0,7,0" Padding="3" CornerRadius="8"
                VerticalAlignment="Top">
            <StackPanel>
                <Grid>
                    <Button Command="{Binding BeginNoteCommand}" ToolTip="{input:ShortcutHint Note}" IsEnabled="{Binding Project.CanEdit}"
                            AutomationProperties.Name="Добавить текст">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ToolRailButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNoteToolActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SelectedBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Path Style="{StaticResource ToolRailSymbol}" Data="M3,4 H17 M10,4 V16 M7,16 H13"/>
                    </Button>
                    <Border Style="{StaticResource ToolRailMarker}" IsHitTestVisible="False"
                            Visibility="{Binding IsNoteToolActive, Converter={StaticResource VisibleIf}}"/>
                </Grid>
                <Grid Margin="0,3,0,0">
                    <Button Command="{Binding ToggleRulerCommand}" ToolTip="{input:ShortcutHint Measure}" AutomationProperties.Name="Линейка">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ToolRailButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRulerActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SelectedBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Path Style="{StaticResource ToolRailSymbol}" Data="M2,6 H18 V14 H2 Z M6,6 V10 M10,6 V12 M14,6 V10"/>
                    </Button>
                    <Border Style="{StaticResource ToolRailMarker}" IsHitTestVisible="False"
                            Visibility="{Binding IsRulerActive, Converter={StaticResource VisibleIf}}"/>
                </Grid>
                <ToggleButton IsChecked="{Binding ShowWireLabels}" ToolTip="{input:ShortcutHint WireLabels}"
                              AutomationProperties.Name="Подписи контактов" Style="{StaticResource ToolRailToggle}">
                    <Path Style="{StaticResource ToolRailSymbol}" Data="M2,6 H10 L17,11 10,16 H2 Z M5,9 H9 M5,13 H9"/>
                </ToggleButton>
                <Border Height="1" Margin="6,5" Background="{DynamicResource SubtleLineBrush}"/>
                <ToggleButton IsChecked="{Binding IsNetInspectionActive}" ToolTip="Подсветить электрический узел · щёлкните по контакту"
                              AutomationProperties.Name="Подсветить электрический узел" Style="{StaticResource ToolRailToggle}">
                    <Path Style="{StaticResource ToolRailSymbol}"
                          Data="M5,9 H9 M12,8 L15,4 M12,10 L15,15 M4,7 A2,2 0 1 1 4,11 A2,2 0 1 1 4,7 M11,7 A2,2 0 1 1 11,11 A2,2 0 1 1 11,7 M16,1 A2,2 0 1 1 16,5 A2,2 0 1 1 16,1 M16,14 A2,2 0 1 1 16,18 A2,2 0 1 1 16,14"/>
                </ToggleButton>
                <Button Command="{Binding FocusSelectionCommand}" IsEnabled="{Binding CanFocusSelection}"
                        ToolTip="Приблизить выделенные детали" AutomationProperties.Name="Приблизить выделение"
                        Style="{StaticResource ToolRailButton}" Margin="0,3,0,0">
                    <Path Style="{StaticResource ToolRailSymbol}"
                          Data="M2,6 V2 H6 M12,2 H16 V6 M16,12 V16 H12 M6,16 H2 V12 M6,9 H12 M9,6 V12"/>
                </Button>
                <ToggleButton IsChecked="{Binding ShowGrid}" ToolTip="Показать или скрыть сетку холста"
                              AutomationProperties.Name="Сетка холста" Style="{StaticResource ToolRailToggle}">
                    <Path Style="{StaticResource ToolRailSymbol}" Data="M2,2 H16 V16 H2 Z M2,7 H16 M2,11 H16 M7,2 V16 M11,2 V16"/>
                </ToggleButton>
                <Border Height="1" Margin="6,5" Background="{DynamicResource SubtleLineBrush}"/>
                <Button Style="{StaticResource ToolRailButton}" Command="{Binding ArmQuickPlacementCommand}" CommandParameter="splitter"
                        input:PaletteDragBehavior.QuickItem="splitter" IsEnabled="{Binding Project.CanEdit}"
                        ToolTip="Разветвитель" AutomationProperties.Name="Разветвитель">
                    <Path Style="{StaticResource ToolRailSymbol}" Data="M2,10 H8 M8,4 V16 M8,4 H17 M8,10 H17 M8,16 H17"/>
                </Button>
                <Button Style="{StaticResource ToolRailButton}" Command="{Binding ArmQuickPlacementCommand}" CommandParameter="resistor"
                        input:PaletteDragBehavior.QuickItem="resistor" IsEnabled="{Binding Project.CanEdit}"
                        ToolTip="Резистор" AutomationProperties.Name="Резистор" Margin="0,3,0,0">
                    <Path Style="{StaticResource ToolRailSymbol}" Data="M1,10 H4 L6,6 9,14 12,6 15,14 17,10 H19"/>
                </Button>
                <Button Style="{StaticResource ToolRailButton}" Command="{Binding ArmQuickPlacementCommand}" CommandParameter="arduino-uno"
                        input:PaletteDragBehavior.QuickItem="arduino-uno" IsEnabled="{Binding Project.CanEdit}"
                        ToolTip="Arduino Uno" AutomationProperties.Name="Arduino Uno" Margin="0,3,0,0">
                    <Path Style="{StaticResource ToolRailSymbol}" Data="M3,3 H15 L18,6 V16 H3 Z M1,7 H5 V11 H1 Z M8,7 H14 V12 H8 Z M7,5 H15 M7,14 H15"/>
                </Button>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource Panel}" ClipToBounds="True" Background="{DynamicResource WorkSurfaceBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border x:Name="CanvasToolbar" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource SubtleLineBrush}"
                        BorderThickness="0,0,0,1" CornerRadius="7,7,0,0" Padding="7,3">
                    <DockPanel>
                        <ToggleButton x:Name="SimulationHeader" DockPanel.Dock="Right" VerticalAlignment="Top"
                                      Style="{StaticResource CanvasToggle}" IsChecked="{Binding IsSimulationSettingsOpen, Mode=TwoWay}"
                                      ToolTip="Параметры симуляции" AutomationProperties.Name="Параметры симуляции">
                            <StackPanel Orientation="Horizontal">
                                <Path x:Name="Chevron" Style="{StaticResource CanvasToggleIcon}"
                                      Data="M5,1 H8 L9,3 11,3 12,5 11,6 11,8 12,9 11,11 9,11 8,13 H5 L4,11 2,11 1,9 2,8 2,6 1,5 2,3 H4 Z M8.5,7 A2,2 0 1 1 4.5,7 A2,2 0 1 1 8.5,7"/>
                                <TextBlock Text="Параметры симуляции" VerticalAlignment="Center"
                                           Visibility="{Binding ActualWidth, ElementName=CanvasToolbar, Converter={StaticResource ToolbarLabelVisibility}}"/>
                            </StackPanel>
                        </ToggleButton>
                        <WrapPanel VerticalAlignment="Center" IsEnabled="{Binding Project.CanEdit}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource CanvasAction}" Content="↶" Width="28" Padding="0" FontSize="16"
                                        Command="{Binding Project.UndoCommand}" ToolTip="{input:ShortcutHint Undo}"
                                        AutomationProperties.Name="Отменить"/>
                                <Button Style="{StaticResource CanvasAction}" Content="↷" Width="28" Padding="0" FontSize="16"
                                        Command="{Binding Project.RedoCommand}" ToolTip="{input:ShortcutHint Redo}"
                                        AutomationProperties.Name="Повторить"/>
                                <Border Style="{StaticResource ToolbarSeparator}"/>
                            </StackPanel>
                            <ToggleButton Style="{StaticResource CanvasToggle}" IsChecked="{Binding Project.Wiring.IsWiring, Mode=TwoWay}"
                                          ToolTip="{input:ShortcutHint Wire}" AutomationProperties.Name="Провод">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource CanvasToggleIcon}" Data="M1,9 A2,2 0 1 0 5,9 A2,2 0 1 0 1,9 M5,9 H8 V3 H11 M11,3 A2,2 0 1 0 15,3 A2,2 0 1 0 11,3"/>
                                    <TextBlock Text="Провод"/>
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource CanvasToggle}" IsChecked="{Binding Project.Wiring.IsStraight, Mode=TwoWay}"
                                          ToolTip="Соединять узлы прямыми сегментами" AutomationProperties.Name="Прямые сегменты">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource CanvasToggleIcon}" Data="M1,9 H7 V3 H13"/>
                                    <TextBlock Text="Прямые сегменты"/>
                                </StackPanel>
                            </ToggleButton>
                            <StackPanel Orientation="Horizontal">
                                <ComboBox ItemsSource="{Binding Project.Wiring.Colors}" SelectedItem="{Binding Project.Wiring.Color}"
                                          Width="51" Height="28" Margin="3,2" ToolTip="Цвет выбранной или новой перемычки"
                                          AutomationProperties.Name="Цвет перемычки">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <Ellipse Width="14" Height="14" Fill="{Binding}" ToolTip="{Binding}"
                                                     AutomationProperties.Name="{Binding}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Border Style="{StaticResource ToolbarSeparator}"/>
                            </StackPanel>
                            <Button Style="{StaticResource CanvasAction}" Content="Повернуть"
                                    Command="{Binding RotateSelectedCommand}" ToolTip="{input:ShortcutHint Rotate}"/>
                            <Button Content="Удалить" Command="{Binding DeleteSelectedCommand}" ToolTip="{input:ShortcutHint Delete}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource DangerQuietAction}">
                                        <Setter Property="Height" Value="28"/>
                                        <Setter Property="Padding" Value="7,0"/>
                                        <Setter Property="Margin" Value="0,2"/>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Style="{StaticResource CanvasAction}" Content="Сбросить вид"
                                    Command="{Binding ResetViewCommand}" ToolTip="{input:ShortcutHint Reset}"/>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource ToolbarSeparator}"/>
                                <TextBlock Text="{Binding SpanLabel}" Foreground="{DynamicResource MutedBrush}"
                                           VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <Grid Margin="0,2,3,2">
                                    <ComboBox ItemsSource="{Binding SpanOptions}" SelectedItem="{Binding SelectedSpan, Mode=TwoWay}"
                                              input:SelectionRefreshBehavior.Enabled="True" IsEnabled="{Binding CanAdjustSpan}"
                                              MinWidth="58" Height="28" FontFamily="{StaticResource ReadoutFont}"
                                              AutomationProperties.Name="{Binding SpanLabel}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontFamily="{StaticResource ReadoutFont}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Text="—" FontFamily="{StaticResource ReadoutFont}" Foreground="{DynamicResource MutedBrush}"
                                               Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SpanOptions.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <TextBlock Text="{Binding SpanUnit}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </WrapPanel>
                    </DockPanel>
                </Border>

                <Grid Grid.Row="1" x:Name="CanvasViewport" ClipToBounds="True">
                    <controls:BreadboardSurface Simulation="{Binding Simulation.State}" ShowVoltage="{Binding Simulation.ShowVoltage}"
                        ShowCurrent="{Binding Simulation.ShowCurrent}" Scene="{Binding}" Revision="{Binding Revision}"
                        AllowDrop="{Binding Project.CanEdit}" input:CanvasInputBehavior.Command="{Binding InputCommand}"
                        AutomationProperties.Name="Макет электрической цепи">
                        <controls:BreadboardSurface.Style>
                            <Style TargetType="controls:BreadboardSurface">
                                <Setter Property="Background" Value="{DynamicResource CanvasFieldBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowGrid}" Value="False">
                                        <Setter Property="Background" Value="{DynamicResource WorkSurfaceBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </controls:BreadboardSurface.Style>
                    </controls:BreadboardSurface>
                    <views:InstrumentDeckView DataContext="{Binding Simulation.Instruments}"/>
                    <Border x:Name="SimulationBody" HorizontalAlignment="Right" VerticalAlignment="Top" MaxWidth="455"
                            Margin="7" Padding="10,8" Style="{StaticResource Panel}"
                            Visibility="{Binding IsSimulationSettingsOpen, Converter={StaticResource VisibleIf}}">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="5,0,0,4">
                                <Button DockPanel.Dock="Right" Style="{StaticResource CanvasAction}" Content="×"
                                        Command="{Binding CloseSimulationSettingsCommand}" ToolTip="Закрыть параметры"
                                        AutomationProperties.Name="Закрыть параметры симуляции"/>
                                <TextBlock Text="Параметры симуляции" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </DockPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <views:SimulationToolbarView DataContext="{Binding Simulation}"/>
                                    <CheckBox Margin="9,3,9,6" Content="Цвета по назначению выводов платы"
                                              IsChecked="{Binding ShowNetColors}"
                                              ToolTip="Питание — медный, сигналы — циан, земля — серый"/>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <Canvas Panel.ZIndex="3">
                        <Border Canvas.Left="{Binding NoteEditorX}" Canvas.Top="{Binding NoteEditorY}" Style="{StaticResource Panel}" Padding="5"
                                MaxWidth="{Binding ActualWidth, ElementName=CanvasViewport}"
                                Visibility="{Binding IsEditingNote, Converter={StaticResource VisibleIf}}">
                            <WrapPanel>
                                <TextBox Width="170" MaxLength="160" Text="{Binding NoteText, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Текст заметки" ToolTip="Enter — сохранить. Esc — закрыть."
                                         input:FocusWhenVisible.Enabled="True">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding SaveNoteCommand}"/>
                                        <KeyBinding Key="Escape" Command="{Binding CancelNoteCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                                <Button Content="Сохранить" Command="{Binding SaveNoteCommand}" Margin="5,0,0,0"/>
                                <Button Content="Удалить" Command="{Binding DeleteNoteCommand}" Margin="5,0,0,0"
                                        Visibility="{Binding CanDeleteNote, Converter={StaticResource VisibleIf}}"/>
                            </WrapPanel>
                        </Border>
                    </Canvas>
                </Grid>
                <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource SubtleLineBrush}"
                        BorderThickness="0,1,0,0" Padding="10,6">
                    <TextBlock x:Name="CanvasFooter" TextTrimming="CharacterEllipsis" FontSize="11"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding Project.Wiring.EndpointSummary}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Project.Wiring.EndpointSummary}" Value="{x:Null}">
                                        <Setter Property="Text" Value="Макетная плата: тяните за край · Провод: выберите два контакта · СКМ: перемещение · Esc: отмена"/>
                                        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
