<UserControl x:Class="CircuitEditor.App.Views.BreadboardView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:CircuitEditor.App.Views"
 xmlns:controls="clr-namespace:CircuitEditor.App.Controls"
 xmlns:input="clr-namespace:CircuitEditor.App.Interaction">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <WrapPanel Margin="12,8" IsEnabled="{Binding Project.CanEdit}">
            <Button Content="↶" Command="{Binding Project.UndoCommand}" ToolTip="Отменить · Ctrl+Z" Margin="0,0,6,0"/>
            <Button Content="↷" Command="{Binding Project.RedoCommand}" ToolTip="Повторить · Ctrl+Y" Margin="0,0,6,0"/>
            <CheckBox Content="Перемычка" IsChecked="{Binding Project.Wiring.IsWiring,Mode=TwoWay}" ToolTip="Перемычки · W — включить/выключить · V / Esc — перемещение" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <ComboBox ItemsSource="{Binding Project.Wiring.Colors}" SelectedItem="{Binding Project.Wiring.Color}" Width="90" Margin="0,0,6,0" ToolTip="Цвет выбранной / новой перемычки">
                <ComboBox.ItemTemplate><DataTemplate><Border Background="{Binding}" Height="16" Width="50" BorderBrush="Gray" BorderThickness="1"/></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <Button Content="↻ R" Command="{Binding RotateSelectedCommand}" ToolTip="{input:ShortcutHint Rotate}" Padding="10,6" FontSize="10" Margin="0,0,6,0"/>
            <Button Content="Удалить" Command="{Binding DeleteSelectedCommand}" ToolTip="{input:ShortcutHint Delete}" Padding="10,6" FontSize="10" Margin="0,0,6,0"/>
            <Button Content="Сброс вида" Command="{Binding ResetViewCommand}" ToolTip="{input:ShortcutHint Reset}" Padding="10,6" FontSize="10" Margin="0,0,10,0"/>
            <TextBlock Text="Шаг ножек:" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox ItemsSource="{Binding SpanOptions}" SelectedItem="{Binding SelectedSpan, Mode=TwoWay}"
                input:SelectionRefreshBehavior.Enabled="True"
                IsEnabled="{Binding CanAdjustSpan}" Width="65" FontSize="10" AutomationProperties.Name="Шаг ножек"/>
            <TextBlock Text="отв." FontSize="10" VerticalAlignment="Center" Margin="6,0"/>
        </WrapPanel>
        <views:SimulationToolbarView Grid.Row="1" DataContext="{Binding Simulation}" />
        <controls:BreadboardSurface Grid.Row="2" Simulation="{Binding Simulation.State}" ShowVoltage="{Binding Simulation.ShowVoltage}" ShowCurrent="{Binding Simulation.ShowCurrent}" Scene="{Binding}" Revision="{Binding Revision}"
            Background="{DynamicResource BackgroundBrush}" input:CanvasInputBehavior.Command="{Binding InputCommand}"
            AutomationProperties.Name="Макет электрической цепи"/>
        <Border Grid.Row="3" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="12,8">
            <TextBlock Text="Breadboard: тяните за край, R — поворот · Esc — перемещение · Перемычка: два клика · Изгиб: выберите провод и потяните линию · Концы/узлы: перетаскивание · Esc: отмена"
                Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</UserControl>
