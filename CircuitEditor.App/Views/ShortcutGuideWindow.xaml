<Window x:Class="CircuitEditor.App.Views.ShortcutGuideWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Icon="pack://application:,,,/CircuitEditor.App;component/Branding/logo.ico"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:input="clr-namespace:CircuitEditor.App.Interaction"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display"
 Title="Горячие клавиши" Width="850" Height="700" MinWidth="700" MinHeight="480" WindowStartupLocation="CenterOwner"
 Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="{StaticResource UiFont}">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="39" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Window.InputBindings><KeyBinding Key="Escape" Command="{Binding CloseCommand}"/></Window.InputBindings>
 <Window.Resources><CollectionViewSource x:Key="GroupedShortcuts" Source="{Binding Entries}">
 <CollectionViewSource.GroupDescriptions><PropertyGroupDescription PropertyName="Group"/></CollectionViewSource.GroupDescriptions>
 </CollectionViewSource></Window.Resources>
 <Border Style="{StaticResource Panel}" Padding="14,0,14,12"><Grid>
 <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <DockPanel Margin="4,0,0,0">
 <Button DockPanel.Dock="Right" Content="×" AutomationProperties.Name="Закрыть" Style="{DynamicResource CloseCaptionButton}" Command="{Binding CloseCommand}" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Закрыть · Esc"/>
 <TextBlock Text="Горячие клавиши" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
 </DockPanel>
 <TextBlock Grid.Row="1" Text="Дважды щёлкните по текущим клавишам в списке и нажмите новое сочетание. Esc отменяет запись." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12"/>
 <Grid Grid.Row="2">
  <TextBox x:Name="HelpSearch" Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Поиск горячих клавиш"/>
  <TextBlock Text="Введите действие или сочетание, например Ctrl+D" IsHitTestVisible="False" VerticalAlignment="Center"
             Foreground="{DynamicResource MutedBrush}" Margin="12,0">
   <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
    <MultiDataTrigger><MultiDataTrigger.Conditions>
     <Condition Binding="{Binding Search}" Value=""/>
     <Condition Binding="{Binding IsKeyboardFocused, ElementName=HelpSearch}" Value="False"/>
    </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger>
   </Style.Triggers></Style></TextBlock.Style>
  </TextBlock>
 </Grid>
 <ListBox Grid.Row="3" ItemsSource="{Binding Source={StaticResource GroupedShortcuts}}" SelectedItem="{Binding Selected}" Margin="0,12" HorizontalContentAlignment="Stretch">
 <ListBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Name}" Foreground="{DynamicResource MutedBrush}" Margin="6,12,0,6" FontWeight="SemiBold"/></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListBox.GroupStyle>
 <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition/></Grid.ColumnDefinitions>
 <Button x:Name="KeyCap" HorizontalAlignment="Left" VerticalAlignment="Top" MinWidth="42" MaxWidth="158"
         Padding="8,4" Margin="0,0,12,0" FontFamily="{StaticResource MonoFont}" FontSize="12"
         AutomationProperties.HelpText="{Binding Description}"
         input:ShortcutCapture.Model="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}">
  <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="{DynamicResource RaisedBrush}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource SubtleLineBrush}"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="AutomationProperties.Name" Value="{Binding Keys}"/>
   <Setter Property="ToolTip" Value="Двойной щелчок или Enter на этой кнопке"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding CanCustomize}" Value="False">
     <Setter Property="IsEnabled" Value="False"/>
    </DataTrigger>
    <Trigger Property="input:ShortcutCapture.IsRecording" Value="True">
     <Setter Property="Background" Value="{DynamicResource SelectedBrush}"/>
     <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
     <Setter Property="AutomationProperties.Name" Value="Нажмите клавиши"/>
    </Trigger>
   </Style.Triggers>
  </Style></Button.Style>
  <TextBlock TextWrapping="Wrap">
   <TextBlock.Style><Style TargetType="TextBlock">
    <Setter Property="Text" Value="{Binding Keys}"/>
    <Style.Triggers>
     <DataTrigger Binding="{Binding (input:ShortcutCapture.IsRecording), ElementName=KeyCap}" Value="True">
      <Setter Property="Text" Value="Нажмите клавиши…"/>
     </DataTrigger>
    </Style.Triggers>
   </Style></TextBlock.Style>
  </TextBlock>
 </Button>
 <StackPanel Grid.Column="1"><TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="13"/><TextBlock Text="{Binding Scope}" TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,4,0,0"/></StackPanel>
 </Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
 <StackPanel Grid.Row="4">
  <WrapPanel>
   <Button Margin="0,0,8,4" Content="Сбросить выбранное" Command="{Binding ResetCommand}"/>
   <Button Margin="0,0,0,4" Content="Сбросить все" Command="{Binding ResetAllCommand}"/>
  </WrapPanel>
  <TextBlock Text="{Binding Feedback}" TextWrapping="Wrap" Foreground="{DynamicResource AccentHoverBrush}" MinHeight="18"/>
 </StackPanel>
 </Grid></Border>
</Window>
