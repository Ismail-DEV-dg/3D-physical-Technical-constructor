<UserControl x:Class="CircuitEditor.App.Views.ChipGraphView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:CircuitEditor.App.Controls">
    <StackPanel>
        <TextBlock Text="Логические блоки" FontWeight="SemiBold"/>
        <TextBlock Text="Провод задаётся источником: P2 — физический вывод 2, B1 — блок 1, 0 / 1 / X / Z — постоянные уровни."
                   TextWrapping="Wrap" Margin="0,4"/>
        <WrapPanel>
            <ComboBox ItemsSource="{Binding Gates}" SelectedItem="{Binding SelectedGate}" SelectedValuePath="Id"
                      DisplayMemberPath="Id" MinWidth="84" Margin="0,0,6,4" AutomationProperties.Name="Номер блока"/>
            <ComboBox ItemsSource="{Binding GateKinds}" SelectedItem="{Binding GateKind}" MinWidth="90" Margin="0,0,6,4" AutomationProperties.Name="Тип блока"/>
            <Button Content="Добавить блок" Command="{Binding AddGateCommand}" Margin="0,0,6,4"/>
            <Button Content="Применить провода" Command="{Binding ApplyGateCommand}" Margin="0,0,6,4"/>
            <Button Content="Удалить блок" Command="{Binding RemoveGateCommand}" Margin="0,0,6,4"/>
        </WrapPanel>
        <TextBlock Text="{Binding PortGuide}" TextWrapping="Wrap" Margin="0,3"/>
        <WrapPanel>
            <StackPanel Width="173" Margin="0,0,6,4">
                <TextBlock Text="Источники через запятую"/>
                <TextBox Text="{Binding GatePorts, UpdateSourceTrigger=PropertyChanged}" ToolTip="Например P1, B2"/>
            </StackPanel>
            <StackPanel Width="108" Margin="0,0,6,4">
                <TextBlock Text="CLEAR (D / JK)"/>
                <TextBox Text="{Binding GateClear, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Width="108" Margin="0,0,6,4">
                <TextBlock Text="PRESET (D / JK)"/>
                <TextBox Text="{Binding GatePreset, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </WrapPanel>
        <TextBlock Text="Привязка выхода" FontWeight="SemiBold" Margin="0,8,0,4"/>
        <WrapPanel>
            <ComboBox ItemsSource="{Binding Links}" SelectedItem="{Binding SelectedLink}" DisplayMemberPath="Pin"
                      MinWidth="84" Margin="0,0,6,4" AutomationProperties.Name="Подключённый выход"/>
            <TextBox Width="100" Text="{Binding OutputPin, UpdateSourceTrigger=PropertyChanged}" ToolTip="Номер физического выхода" Margin="0,0,6,4"/>
            <TextBox Width="100" Text="{Binding OutputSource, UpdateSourceTrigger=PropertyChanged}" ToolTip="Источник сигнала" Margin="0,0,6,4"/>
            <Button Content="Соединить" Command="{Binding ConnectCommand}" Margin="0,0,6,4"/>
            <Button Content="Разъединить" Command="{Binding DisconnectCommand}" Margin="0,0,6,4"/>
        </WrapPanel>
        <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,6">
            <controls:ChipGraphPreview Graph="{Binding Graph}" AutomationProperties.Name="Граф соединений"/>
        </ScrollViewer>
    </StackPanel>
</UserControl>
