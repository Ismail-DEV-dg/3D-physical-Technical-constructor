<UserControl x:Class="CircuitEditor.App.Views.ChipLibraryView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="0,8,0,4">
        <TextBlock Text="Шаблоны и пользовательская библиотека" FontWeight="SemiBold" Margin="0,0,0,5"/>
        <WrapPanel>
            <ComboBox ItemsSource="{Binding Templates}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedTemplate}"
                      MinWidth="146" AutomationProperties.Name="Встроенный шаблон" Margin="0,0,6,4"/>
            <Button Content="Открыть шаблон" Command="{Binding UseTemplateCommand}" Margin="0,0,6,4"/>
            <ComboBox ItemsSource="{Binding Saved}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedChip}"
                      MinWidth="146" AutomationProperties.Name="Сохранённая микросхема" Margin="0,0,6,4"/>
            <Button Content="Редактировать" Command="{Binding EditSavedCommand}" Margin="0,0,6,4"/>
            <Button Content="Удалить" Command="{Binding DeleteCommand}" Margin="0,0,6,4"/>
            <Button Content="Обновить список" Command="{Binding ReloadLibraryCommand}" Margin="0,0,6,4"/>
        </WrapPanel>
        <TextBlock Text="{Binding SelectedTemplate.Description}" TextWrapping="Wrap" Margin="0,2,0,4"/>
        <WrapPanel>
            <Button Content="Сохранить в библиотеку" Command="{Binding SaveCommand}" Margin="0,0,6,4"/>
            <Button Content="Импорт .chip" Command="{Binding ImportCommand}" Margin="0,0,6,4"/>
            <Button Content="Экспорт .chip" Command="{Binding ExportCommand}" Margin="0,0,6,4"/>
            <TextBox Text="{Binding CopyName, UpdateSourceTrigger=PropertyChanged}" Width="130" ToolTip="Имя дубликата" Margin="0,0,6,4"/>
            <Button Content="Сохранить дубликат" Command="{Binding DuplicateCommand}" Margin="0,0,6,4"/>
        </WrapPanel>
    </StackPanel>
</UserControl>
