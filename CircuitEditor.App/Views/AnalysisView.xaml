<UserControl x:Class="CircuitEditor.App.Views.AnalysisView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:input="clr-namespace:CircuitEditor.App.Interaction">
 <TabControl Margin="8,4" Style="{StaticResource PaneTabs}">
  <TabItem Header="Проверка"><WrapPanel Margin="8">
   <Button Content="Проверить" Command="{Binding CheckCommand}" Padding="10,5" ToolTip="{input:ShortcutHint Check}"/>
  </WrapPanel></TabItem>
  <TabItem Header="Расчёт DC"><WrapPanel Margin="8">
   <Button Content="Рассчитать цепь" Command="{Binding CalculateCommand}" Padding="10,5" ToolTip="{input:ShortcutHint Calculate}"/>
   <CheckBox Content="Показать напряжения" IsChecked="{Binding Results.ShowVoltages}" Margin="12,0"/>
  </WrapPanel></TabItem>
 </TabControl>
</UserControl>
