<UserControl x:Class="CircuitEditor.App.Views.SchematicView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="clr-namespace:CircuitEditor.App.ViewModels"
 xmlns:controls="clr-namespace:CircuitEditor.App.Controls"
 xmlns:input="clr-namespace:CircuitEditor.App.Interaction">
    <UserControl.Resources>
        <Style x:Key="CanvasAction" TargetType="Button" BasedOn="{StaticResource QuietAction}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
    </UserControl.Resources>
    <Border Style="{StaticResource Panel}" Background="{DynamicResource WorkSurfaceBrush}" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource SubtleLineBrush}"
                    BorderThickness="0,0,0,1" CornerRadius="7,7,0,0" Padding="7,3">
                <WrapPanel>
                    <Button Style="{StaticResource CanvasAction}" Content="Соединения в макете"
                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{x:Static vm:WorkspaceKind.Mockup}"/>
                    <Border Style="{StaticResource ToolbarSeparator}"/>
                    <Button Style="{StaticResource CanvasAction}" Content="Повернуть"
                            Command="{Binding RotateSelectedCommand}" ToolTip="{input:ShortcutHint Rotate}"/>
                    <Button Content="Удалить" Command="{Binding DeleteSelectedCommand}" ToolTip="{input:ShortcutHint Delete}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource DangerQuietAction}">
                                <Setter Property="Height" Value="28"/>
                                <Setter Property="Padding" Value="8,0"/>
                                <Setter Property="Margin" Value="0,2"/>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Style="{StaticResource CanvasAction}" Content="Сбросить вид"
                            Command="{Binding ResetViewCommand}" ToolTip="{input:ShortcutHint Reset}"/>
                    <Border Style="{StaticResource ToolbarSeparator}"/>
                    <TextBlock Text="{Binding SelectedCount, StringFormat=Выбрано: {0}}" Foreground="{DynamicResource MutedBrush}"
                               VerticalAlignment="Center" Margin="3,0"/>
                </WrapPanel>
            </Border>
            <controls:SchematicSurface Grid.Row="1" Scene="{Binding}" Revision="{Binding Revision}"
                Background="{DynamicResource WorkSurfaceBrush}" ClipToBounds="True" AllowDrop="{Binding Project.CanEdit}"
                input:CanvasInputBehavior.Command="{Binding InputCommand}" AutomationProperties.Name="Холст схемы"/>
            <Border Grid.Row="1" Background="{DynamicResource CanvasHintBrush}" BorderBrush="{DynamicResource SubtleLineBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="11,6" Margin="8"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" IsHitTestVisible="False">
                <TextBlock Text="F1: справка · V / Esc: выбор · R: поворот · Ctrl+D: копия"
                           Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
