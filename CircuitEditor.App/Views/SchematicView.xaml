<UserControl x:Class="CircuitEditor.App.Views.SchematicView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:CircuitEditor.App.Controls"
 xmlns:input="clr-namespace:CircuitEditor.App.Interaction">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <WrapPanel Margin="12,8">
            <Button Content="↻  Повернуть · R" Command="{Binding RotateSelectedCommand}" Padding="10,6" FontSize="10" Margin="0,0,6,0"/>
            <Button Content="Удалить · Del" Command="{Binding DeleteSelectedCommand}" Padding="10,6" FontSize="10" Margin="0,0,6,0"/>
            <Button Content="Сброс вида" Command="{Binding ResetViewCommand}" Padding="10,6" FontSize="10"/>
            <TextBlock Text="{Binding SelectedCount, StringFormat=Выбрано: {0}}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="12,0"/>
        </WrapPanel>
        <controls:SchematicSurface Grid.Row="1" Scene="{Binding}" Revision="{Binding Revision}"
            Background="{DynamicResource BackgroundBrush}" ClipToBounds="True"
            input:CanvasInputBehavior.Command="{Binding InputCommand}"
            AutomationProperties.Name="Холст схемы"/>
        <Border Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="12,8">
            <TextBlock Text="Сетка 20 · Ctrl — мультивыбор · СКМ / ПКМ — панорама · R / Del" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</UserControl>
