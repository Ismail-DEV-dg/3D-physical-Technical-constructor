<UserControl x:Class="CircuitEditor.App.Views.PassiveNominalView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="{Binding Caption}" Style="{StaticResource MutedText}" Margin="0,16,0,7"/>
        <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}" DisplayMemberPath="Text"
                  MaxDropDownHeight="300" AutomationProperties.Name="Номинал пассивного компонента"/>
        <StackPanel>
            <StackPanel.Style><Style TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers><DataTrigger Binding="{Binding IsCustomEntry}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
            </Style></StackPanel.Style>
            <TextBlock Text="{Binding Hint}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8"/>
            <TextBox Text="{Binding CustomText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Свой номинал пассивного компонента"/>
            <Button Content="Выбрать номинал" Command="{Binding ApplyCustomCommand}" Margin="0,8,0,0"/>
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource RedBrush}" TextWrapping="Wrap"/>
        </StackPanel>
    </StackPanel>
</UserControl>
