<UserControl x:Class="CircuitEditor.App.Views.SimulationToolbarView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <WrapPanel Margin="9,4,9,6">
  <Button Style="{StaticResource PrimaryAction}" Content="Старт" Command="{Binding StartCommand}" Margin="0,0,5,0"/>
  <Button Content="Пауза" Command="{Binding PauseCommand}" Margin="0,0,5,0"/>
  <Button Content="Шаг" Command="{Binding StepCommand}" ToolTip="Один шаг модельного времени · 1 мс" Margin="0,0,5,0"/>
  <Button Content="Стоп" Command="{Binding ResetCommand}" ToolTip="Завершить сеанс и вернуться к редактированию" Margin="0,0,10,0"/>
  <Button Content="Сценарий и GPIO" Command="{Binding ShowConfigurationCommand}" Margin="0,0,8,0"/>
  <Slider Minimum="0.1" Maximum="10" Value="{Binding Speed}" Width="85" VerticalAlignment="Center" AutomationProperties.Name="Скорость симуляции"/>
  <TextBlock Text="{Binding Speed, StringFormat={}{0:0.0}×}" Margin="6,0,12,0" VerticalAlignment="Center"/>
  <CheckBox Content="Напряжение" IsChecked="{Binding ShowVoltage}" VerticalAlignment="Center" Margin="0,0,8,0"/>
  <CheckBox Content="Показать ток" IsChecked="{Binding ShowCurrent}" VerticalAlignment="Center" Margin="0,0,8,0"/>
  <TextBlock Text="{Binding Status}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
 </WrapPanel>
</UserControl>
