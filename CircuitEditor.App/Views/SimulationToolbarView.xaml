<UserControl x:Class="CircuitEditor.App.Views.SimulationToolbarView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <DockPanel Margin="2,4,2,2">
  <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
 <WrapPanel>
  <Button Style="{DynamicResource RunAction}" Content="Старт схемы" Command="{Binding StartCircuitCommand}" Margin="0,0,5,5"
          ToolTip="Ручной GPIO или встроенный сценарий"/>
  <Button Content="Пауза" Command="{Binding PauseCommand}" Margin="0,0,5,5">
   <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Style.Triggers><DataTrigger Binding="{Binding IsSketchSession}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
   </Style></Button.Style>
  </Button>
  <Button Content="Шаг" Command="{Binding StepCommand}" ToolTip="Один шаг модельного времени · 1 мс" Margin="0,0,5,5"/>
  <Button Style="{DynamicResource StopAction}" Content="Стоп" Command="{Binding ResetCommand}" ToolTip="Завершить сеанс и вернуться к редактированию" Margin="0,0,10,5"/>
  <Button Content="Сценарий и GPIO" Command="{Binding ShowConfigurationCommand}" Margin="0,0,8,5"/>
  <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,5">
   <Slider Minimum="0.1" Maximum="10" Value="{Binding Speed}" Width="85" VerticalAlignment="Center" AutomationProperties.Name="Скорость симуляции"/>
   <TextBlock Text="{Binding Speed, StringFormat={}{0:0.0}×}" Margin="6,0,0,0" VerticalAlignment="Center"/>
  </StackPanel>
  <CheckBox Content="Напряжение" IsChecked="{Binding ShowVoltage}" VerticalAlignment="Center" Margin="0,0,8,5"/>
  <CheckBox Content="Показать ток" IsChecked="{Binding ShowCurrent}" VerticalAlignment="Center" Margin="0,0,8,5"/>
 </WrapPanel>
 </DockPanel>
</UserControl>
