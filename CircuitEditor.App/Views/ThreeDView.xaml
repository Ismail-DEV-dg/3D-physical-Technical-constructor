<UserControl x:Class="CircuitEditor.App.Views.ThreeDView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:CircuitEditor.App.Views"
 xmlns:threeD="clr-namespace:CircuitEditor.App.Controls.ThreeD">
    <Grid Background="{DynamicResource WorkSurfaceBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource SubtleLineBrush}"
                BorderThickness="0,0,0,1" Padding="9,7,9,3">
        <WrapPanel>
            <Button Content="Сверху" Command="{Binding TopCommand}" Margin="0,0,6,4"/>
            <Button Content="Спереди" Command="{Binding FrontCommand}" Margin="0,0,6,4"/>
            <Button Content="Изометрия" Command="{Binding IsometricCommand}" Margin="0,0,6,4"/>
            <Button Content="Показать всё" Command="{Binding FitCommand}" Margin="0,0,6,4"/>
            <Button Content="Сброс вида" Command="{Binding ResetCameraCommand}" Margin="0,0,16,4"/>
            <CheckBox Content="Провода" IsChecked="{Binding ShowWires}" Margin="0,0,10,4" VerticalAlignment="Center"/>
            <CheckBox Content="Подписи" IsChecked="{Binding ShowLabels}" Margin="0,0,10,4" VerticalAlignment="Center"/>
            <CheckBox Content="Платы" IsChecked="{Binding ShowBoards}" Margin="0,0,10,4" VerticalAlignment="Center"/>
            <CheckBox Content="Макетная плата" IsChecked="{Binding ShowBreadboard}" Margin="0,0,0,4" VerticalAlignment="Center"/>
            <Button Content="PNG…" Command="{Binding DataContext.Exports.PngCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                Margin="12,0,6,4" ToolTip="Снимок области 3D"/>
            <Button Content="OBJ…" Command="{Binding DataContext.Exports.ObjCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                Margin="0,0,0,4" ToolTip="Геометрия и материалы видимой сцены"/>
        </WrapPanel>
        </Border>
        <StackPanel Grid.Row="1" Margin="9,5">
            <ToggleButton x:Name="SimulationSettings" Content="Параметры симуляции" HorizontalAlignment="Left"/>
            <views:SimulationToolbarView DataContext="{Binding Simulation}" Margin="0,5,0,0">
                <views:SimulationToolbarView.Style>
                    <Style TargetType="{x:Type views:SimulationToolbarView}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=SimulationSettings}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:SimulationToolbarView.Style>
            </views:SimulationToolbarView>
        </StackPanel>
        <threeD:SceneViewport Grid.Row="2" Background="{DynamicResource WorkSurfaceBrush}"
            AutomationProperties.Name="Трёхмерный вид макета"/>
        <Border Grid.Row="3" Background="{DynamicResource ChromeBrush}" Padding="12,7">
            <StackPanel>
                <TextBlock Text="ЛКМ — выбор · ПКМ — вращение · СКМ — панорама · Колесо — масштаб"
                    Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Notice}" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                            <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
