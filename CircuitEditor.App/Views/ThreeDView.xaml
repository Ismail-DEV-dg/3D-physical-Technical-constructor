<UserControl x:Class="CircuitEditor.App.Views.ThreeDView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:CircuitEditor.App.Views"
 xmlns:threeD="clr-namespace:CircuitEditor.App.Controls.ThreeD">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <WrapPanel Margin="9,6">
            <Button Content="Сверху" Command="{Binding TopCommand}" Margin="0,0,6,4"/>
            <Button Content="Спереди" Command="{Binding FrontCommand}" Margin="0,0,6,4"/>
            <Button Content="Изометрия" Command="{Binding IsometricCommand}" Margin="0,0,6,4"/>
            <Button Content="Показать всё" Command="{Binding FitCommand}" Margin="0,0,6,4"/>
            <Button Content="Сброс вида" Command="{Binding ResetCameraCommand}" Margin="0,0,16,4"/>
            <CheckBox Content="Провода" IsChecked="{Binding ShowWires}" Margin="0,0,10,4" VerticalAlignment="Center"/>
            <CheckBox Content="Подписи" IsChecked="{Binding ShowLabels}" Margin="0,0,10,4" VerticalAlignment="Center"/>
            <CheckBox Content="Платы" IsChecked="{Binding ShowBoards}" Margin="0,0,10,4" VerticalAlignment="Center"/>
            <CheckBox Content="Breadboard" IsChecked="{Binding ShowBreadboard}" Margin="0,0,0,4" VerticalAlignment="Center"/>
        </WrapPanel>
        <views:SimulationToolbarView Grid.Row="1" DataContext="{Binding Simulation}"/>
        <threeD:SceneViewport Grid.Row="2" Background="{DynamicResource CanvasFieldBrush}"
            AutomationProperties.Name="Трёхмерный вид макета"/>
        <Border Grid.Row="3" Background="{DynamicResource ChromeBrush}" Padding="12,7">
            <StackPanel>
                <TextBlock Text="ЛКМ — выбор · ПКМ — вращение · СКМ — панорама · Колесо — масштаб"
                    Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Notice}" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                            <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
