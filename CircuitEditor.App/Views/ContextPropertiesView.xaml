<UserControl x:Class="CircuitEditor.App.Views.ContextPropertiesView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:CircuitEditor.App.Views">
 <UserControl.Style>
  <Style TargetType="UserControl">
   <Setter Property="Visibility" Value="Collapsed"/>
   <Style.Triggers>
    <MultiDataTrigger>
     <MultiDataTrigger.Conditions><Condition Binding="{Binding IsCanvas}" Value="True"/><Condition Binding="{Binding Panels.Inspector.IsVisible}" Value="True"/></MultiDataTrigger.Conditions>
     <Setter Property="Visibility" Value="Visible"/>
    </MultiDataTrigger>
   </Style.Triggers>
  </Style>
 </UserControl.Style>
 <Border Margin="0,6,0,0" Padding="8,4" IsEnabled="{Binding Project.CanEdit}">
  <Border.Style>
   <Style TargetType="Border" BasedOn="{StaticResource Panel}">
    <Style.Triggers>
     <MultiDataTrigger>
      <MultiDataTrigger.Conditions><Condition Binding="{Binding Project.SelectedComponent}" Value="{x:Null}"/><Condition Binding="{Binding Project.Wiring.HasSelection}" Value="False"/></MultiDataTrigger.Conditions>
      <Setter Property="Visibility" Value="Collapsed"/>
     </MultiDataTrigger>
    </Style.Triggers>
   </Style>
  </Border.Style>
  <DockPanel>
   <CheckBox x:Name="Details" DockPanel.Dock="Right" VerticalAlignment="Top" HorizontalAlignment="Right" Content="Свойства"
                 IsChecked="{Binding Panels.Inspector.IsOpen, Mode=TwoWay}" AutomationProperties.Name="Подробные свойства"/>
   <StackPanel>
    <WrapPanel VerticalAlignment="Center">
     <TextBlock Text="{Binding Project.SelectedComponent.Reference}" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" Foreground="{DynamicResource AccentHoverBrush}" Margin="3,5,12,5"/>
     <TextBlock Text="{Binding Project.SelectedComponent.Name}" VerticalAlignment="Center" Margin="0,0,12,0"/>
     <StackPanel Orientation="Horizontal" DataContext="{Binding Project.SelectedComponent.ResistorEditor}">
      <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers>
       <DataTrigger Binding="{Binding}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
      </Style.Triggers></Style></StackPanel.Style>
      <TextBlock Text="Сопротивление" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}" DisplayMemberPath="Text" MinWidth="104" MaxDropDownHeight="212"
                AutomationProperties.Name="Сопротивление"/>
      <WrapPanel>
       <WrapPanel.Style><Style TargetType="WrapPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
        <DataTrigger Binding="{Binding IsCustomEntry}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
       </Style.Triggers></Style></WrapPanel.Style>
       <TextBox Text="{Binding CustomText,UpdateSourceTrigger=PropertyChanged}" Width="94" Margin="6,0" AutomationProperties.Name="Своё сопротивление"/>
       <Button Content="Применить" Command="{Binding ApplyCustomCommand}"/>
       <TextBlock Text="{Binding Error}" Foreground="{DynamicResource RedBrush}" VerticalAlignment="Center" MaxWidth="240" TextWrapping="Wrap" Margin="6,0"/>
      </WrapPanel>
     </StackPanel>
     <CheckBox Content="Прямые сегменты" IsChecked="{Binding Project.Wiring.IsStraight,Mode=TwoWay}" VerticalAlignment="Center">
      <CheckBox.Style><Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
       <DataTrigger Binding="{Binding Project.Wiring.HasSelection}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
      </Style.Triggers></Style></CheckBox.Style>
     </CheckBox>
    </WrapPanel>
    <views:PropertiesView DataContext="{Binding Project}" MaxHeight="195">
     <views:PropertiesView.Style><Style TargetType="views:PropertiesView">
      <Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=Details}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
     </Style></views:PropertiesView.Style>
    </views:PropertiesView>
   </StackPanel>
  </DockPanel>
 </Border>
</UserControl>
