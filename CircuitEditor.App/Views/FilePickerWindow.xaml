<Window x:Class="CircuitEditor.App.Views.FilePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:input="clr-namespace:CircuitEditor.App.Interaction"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Icon="pack://application:,,,/CircuitEditor.App;component/Branding/logo.ico"
        Title="{Binding Title}" Width="780" Height="520" MinWidth="560" MinHeight="390"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource ChromeBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources><BooleanToVisibilityConverter x:Key="VisibleIf"/></Window.Resources>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="39" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
        <KeyBinding Key="Up" Modifiers="Alt" Command="{Binding UpCommand}"/>
    </Window.InputBindings>
    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
        <Grid Margin="12,0,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="4,0,0,4">
                <Button DockPanel.Dock="Right" Content="×" Style="{DynamicResource CloseCaptionButton}"
                        Command="{Binding CancelCommand}" AutomationProperties.Name="Закрыть" ToolTip="Закрыть · Esc"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
            <StackPanel Grid.Row="1" Margin="0,4,0,10">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="↑" MinWidth="32" ToolTip="Родительская папка · Alt+↑"
                        AutomationProperties.Name="Родительская папка" IsEnabled="{Binding CanGoUp}"
                        Command="{Binding UpCommand}" Margin="0,0,6,0"/>
                <Button DockPanel.Dock="Right" Content="Перейти" Command="{Binding GoToAddressCommand}" Margin="6,0,0,0"/>
                <Button DockPanel.Dock="Right" Content="Новая папка" Command="{Binding ShowNewFolderCommand}" Margin="6,0,0,0"
                        Visibility="{Binding IsSaving,Converter={StaticResource VisibleIf}}"/>
                <TextBox x:Name="FolderAddress" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Путь к папке">
                    <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding GoToAddressCommand}"/></TextBox.InputBindings>
                </TextBox>
            </DockPanel>
            <DockPanel Margin="0,6,0,0" Visibility="{Binding IsCreatingFolder,Converter={StaticResource VisibleIf}}">
                <Button DockPanel.Dock="Right" Content="Отмена" Command="{Binding CancelNewFolderCommand}" Margin="6,0,0,0"/>
                <Button DockPanel.Dock="Right" Content="Создать" Command="{Binding CreateFolderCommand}" Margin="6,0,0,0"/>
                <TextBlock DockPanel.Dock="Left" Text="Имя новой папки" VerticalAlignment="Center" Margin="2,0,8,0"/>
                <TextBox Text="{Binding NewFolderName,UpdateSourceTrigger=PropertyChanged}" input:FocusWhenVisible.Enabled="True"
                         AutomationProperties.Name="Имя новой папки">
                    <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding CreateFolderCommand}"/></TextBox.InputBindings>
                </TextBox>
            </DockPanel>
            </StackPanel>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="154"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Panel}" Padding="6" Margin="0,0,8,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Места" Foreground="{DynamicResource MutedBrush}" Margin="7,4,0,6"/>
                        <ListBox ItemsSource="{Binding Locations}" SelectedItem="{Binding SelectedLocation}"
                                 AutomationProperties.Name="Папки и диски">
                            <ListBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding Name}" TextWrapping="Wrap"/></DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Panel}" Background="{DynamicResource WorkSurfaceBrush}" Padding="6">
                    <ListBox ItemsSource="{Binding Entries}" SelectedItem="{Binding Selected}"
                             AutomationProperties.Name="Содержимое папки" HorizontalContentAlignment="Stretch">
                        <ListBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding OpenSelectedCommand}"/>
                        </ListBox.InputBindings>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Background="Transparent">
                                    <DockPanel.InputBindings>
                                        <MouseBinding MouseAction="LeftDoubleClick"
                                            Command="{Binding DataContext.OpenEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                    </DockPanel.InputBindings>
                                    <Path DockPanel.Dock="Left" Width="14" Height="13" Margin="0,0,8,0" Stretch="Uniform"
                                          VerticalAlignment="Top" StrokeThickness="1.4">
                                        <Path.Style><Style TargetType="Path">
                                            <Setter Property="Stroke" Value="{DynamicResource MutedBrush}"/>
                                            <Setter Property="Data" Value="M3,1 H10 L15,6 V15 H3 Z M10,1 V6 H15"/>
                                            <Style.Triggers><DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                <Setter Property="Stroke" Value="{DynamicResource AccentHoverBrush}"/>
                                                <Setter Property="Data" Value="M1,4 H7 L9,6 H16 V14 H1 Z"/>
                                            </DataTrigger></Style.Triggers>
                                        </Style></Path.Style>
                                    </Path>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>
            <Grid Grid.Row="3" Margin="0,10,0,0" FocusManager.FocusedElement="{Binding ElementName=FileNameField}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="Имя файла" VerticalAlignment="Center" Margin="2,0,10,0"/>
                <TextBox Grid.Column="1" x:Name="FileNameField" Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Имя файла" Margin="0,0,8,4">
                    <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding AcceptCommand}"/></TextBox.InputBindings>
                </TextBox>
                <TextBlock Grid.Row="1" Text="Тип файла" VerticalAlignment="Center" Margin="2,0,10,0"/>
                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}"
                          DisplayMemberPath="Label" AutomationProperties.Name="Тип файла" Margin="0,0,8,0"/>
                <StackPanel Grid.Column="2" Grid.RowSpan="2" VerticalAlignment="Bottom">
                    <Button Content="{Binding ActionLabel}" Command="{Binding AcceptCommand}" IsDefault="True" Margin="0,0,0,4"/>
                    <Button Content="Отмена" Command="{Binding CancelCommand}"/>
                </StackPanel>
                <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}"
                           TextWrapping="Wrap" Margin="0,4,0,0"/>
            </Grid>
        </Grid>
    </Border>
</Window>
