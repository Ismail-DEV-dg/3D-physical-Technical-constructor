<UserControl x:Class="CircuitEditor.App.Views.WorkspaceView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid ClipToBounds="True">
        <Grid.Background>
            <DrawingBrush TileMode="Tile" Viewport="0,0,28,28" ViewportUnits="Absolute">
                <DrawingBrush.Drawing><GeometryDrawing>
                    <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,28,28"/></GeometryDrawing.Geometry>
                    <GeometryDrawing.Pen><Pen Brush="{DynamicResource GridBrush}" Thickness="0.5"/></GeometryDrawing.Pen>
                </GeometryDrawing></DrawingBrush.Drawing>
            </DrawingBrush>
        </Grid.Background>
        <Grid Margin="24">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="6" Height="6" Fill="{DynamicResource GreenBrush}" Margin="0,0,8,0"/>
                <TextBlock Text="РАБОЧЕЕ ПРОСТРАНСТВО" Style="{StaticResource MutedText}"/>
                <TextBlock Text="{Binding Index, StringFormat= / {0}}" Foreground="{DynamicResource AccentBrush}" FontSize="10"/>
            </StackPanel>
            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460">
                <Border Width="82" Height="82" CornerRadius="20" Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,24">
                    <Border.Effect><DropShadowEffect Color="{DynamicResource AccentColor}" ShadowDepth="0" BlurRadius="28" Opacity="0.22"/></Border.Effect>
                    <Path Data="M 18,8 L 18,0 M 30,8 L 30,0 M 18,40 L 18,48 M 30,40 L 30,48 M 8,18 L 0,18 M 8,30 L 0,30 M 40,18 L 48,18 M 40,30 L 48,30 M 8,8 L 40,8 40,40 8,40 Z M 17,17 L 31,17 31,31 17,31 Z"
                          Width="44" Height="44" Stretch="Uniform" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.4"/>
                </Border>
                <TextBlock Text="{Binding Heading}" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center"/>
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" TextAlignment="Center" LineHeight="23" Margin="12,16,12,0"/>
                <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="12,5" Margin="0,24,0,0" HorizontalAlignment="Center" Background="{DynamicResource PanelBrush}">
                    <TextBlock Text="КАРКАС / ЭТАП 01" FontSize="10" Foreground="{DynamicResource PurpleBrush}"/>
                </Border>
            </StackPanel>
            <Grid Grid.Row="2">
                <TextBlock Text="ARDUINO / ESP32" Style="{StaticResource MutedText}"/>
                <TextBlock Text="X →   Y ↓" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

