<UserControl x:Class="CircuitEditor.App.Views.EditorLayoutView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:CircuitEditor.App.Views"
 xmlns:controls="clr-namespace:CircuitEditor.App.Controls"
 xmlns:input="clr-namespace:CircuitEditor.App.Interaction">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="PaneVisibility"/>
  <CollectionViewSource x:Key="GroupedPalette" Source="{Binding Palette}">
   <CollectionViewSource.GroupDescriptions><PropertyGroupDescription PropertyName="Category"/></CollectionViewSource.GroupDescriptions>
  </CollectionViewSource>
 </UserControl.Resources>
 <Grid x:Name="EditorGrid">
  <Grid.ColumnDefinitions>
   <ColumnDefinition Width="*" MinWidth="320"/>
   <ColumnDefinition Width="6"/>
   <ColumnDefinition x:Name="PaletteColumn" MaxWidth="350">
    <ColumnDefinition.Style>
     <Style TargetType="ColumnDefinition">
      <Setter Property="Width" Value="{Binding Panels.Components.Size,Mode=TwoWay,Converter={StaticResource PaneSize}}"/>
      <Setter Property="MinWidth" Value="185"/>
      <Style.Triggers>
       <DataTrigger Binding="{Binding Panels.Components.IsExpanded}" Value="False">
        <Setter Property="Width" Value="28"/><Setter Property="MinWidth" Value="0"/>
       </DataTrigger>
       <DataTrigger Binding="{Binding Panels.Components.IsVisible}" Value="False">
        <Setter Property="Width" Value="0"/><Setter Property="MinWidth" Value="0"/>
       </DataTrigger>
       <DataTrigger Binding="{Binding IsMockup}" Value="False">
        <Setter Property="Width" Value="0"/><Setter Property="MinWidth" Value="0"/>
       </DataTrigger>
      </Style.Triggers>
     </Style>
    </ColumnDefinition.Style>
   </ColumnDefinition>
  </Grid.ColumnDefinitions>
  <Grid x:Name="CenterGrid">
   <Grid.RowDefinitions>
    <RowDefinition Height="*" MinHeight="160"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition x:Name="AnalysisRow">
     <RowDefinition.MaxHeight>
      <MultiBinding Converter="{StaticResource PaneLimit}" ConverterParameter="Bottom">
       <Binding ElementName="CenterGrid" Path="ActualHeight"/>
      </MultiBinding>
     </RowDefinition.MaxHeight>
     <RowDefinition.Style>
      <Style TargetType="RowDefinition">
       <Setter Property="Height" Value="{Binding Panels.Analysis.Size,Mode=TwoWay,Converter={StaticResource PaneSize}}"/>
       <Setter Property="MinHeight" Value="176"/>
       <Style.Triggers>
        <DataTrigger Binding="{Binding Panels.Analysis.IsExpanded}" Value="False">
         <Setter Property="Height" Value="0"/><Setter Property="MinHeight" Value="0"/>
        </DataTrigger>
       </Style.Triggers>
      </Style>
     </RowDefinition.Style>
    </RowDefinition>
   </Grid.RowDefinitions>
   <DockPanel>
    <views:ContextPropertiesView DockPanel.Dock="Bottom"/>
    <ContentControl Content="{Binding SelectedWorkspace}" Focusable="False"/>
   </DockPanel>
   <GridSplitter Grid.Row="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                 ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" ToolTip="Изменить высоту диагностики">
    <GridSplitter.Style>
     <Style TargetType="GridSplitter" BasedOn="{StaticResource {x:Type GridSplitter}}">
      <Setter Property="Height" Value="6"/>
      <Style.Triggers>
       <DataTrigger Binding="{Binding Panels.Analysis.IsExpanded}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
      </Style.Triggers>
     </Style>
    </GridSplitter.Style>
   </GridSplitter>
   <controls:DockPane Grid.Row="2" x:Name="AnalysisPane" Pane="{Binding Panels.Analysis}" Visibility="{Binding Panels.Analysis.IsExpanded,Converter={StaticResource PaneVisibility}}" IsBottom="True">
    <views:AnalysisView DataContext="{Binding Analysis}"/>
   </controls:DockPane>
  </Grid>
  <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" ResizeDirection="Columns"
                ResizeBehavior="PreviousAndNext" IsEnabled="{Binding Panels.Components.IsExpanded}" ToolTip="Изменить ширину библиотеки">
   <GridSplitter.Style>
    <Style TargetType="GridSplitter" BasedOn="{StaticResource {x:Type GridSplitter}}">
     <Style.Triggers>
      <DataTrigger Binding="{Binding IsMockup}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
      <DataTrigger Binding="{Binding Panels.Components.IsVisible}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
     </Style.Triggers>
    </Style>
   </GridSplitter.Style>
  </GridSplitter>
  <controls:DockPane Grid.Column="2" x:Name="PalettePane" Pane="{Binding Panels.Components}" Badge="{Binding LibraryCount}">
   <controls:DockPane.Style>
    <Style TargetType="controls:DockPane" BasedOn="{StaticResource {x:Type controls:DockPane}}">
     <Style.Triggers>
      <DataTrigger Binding="{Binding IsMockup}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
      <DataTrigger Binding="{Binding Panels.Components.IsVisible}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
     </Style.Triggers>
    </Style>
   </controls:DockPane.Style>
   <Grid Margin="9,9,9,6">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,8">
     <TextBox x:Name="PaletteSearch" Text="{Binding PaletteFilter,UpdateSourceTrigger=PropertyChanged}"
              MinHeight="32" FontFamily="{StaticResource UiFont}" FontSize="12" Padding="28,6,29,6"
              VerticalContentAlignment="Center" ToolTip="Поиск по названию или категории" AutomationProperties.Name="Поиск компонентов"/>
     <Path Data="M8,4 A4,4 0 1 1 0,4 A4,4 0 1 1 8,4 M7,7 L11,11" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.3"
           Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"/>
     <TextBlock Text="Найти компонент…" IsHitTestVisible="False" Margin="28,0,5,0" VerticalAlignment="Center"
                Foreground="{DynamicResource MutedBrush}" FontSize="12">
      <TextBlock.Style>
       <Style TargetType="TextBlock">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
         <DataTrigger Binding="{Binding Text,ElementName=PaletteSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger>
        </Style.Triggers>
       </Style>
      </TextBlock.Style>
     </TextBlock>
     <Button Command="{Binding ClearPaletteSearchCommand}" ToolTip="Очистить поиск" AutomationProperties.Name="Очистить поиск"
             HorizontalAlignment="Right" VerticalAlignment="Center" Width="25" Height="25" Padding="5" Margin="0,0,3,0">
      <Button.Style>
       <Style TargetType="Button" BasedOn="{StaticResource QuietAction}">
        <Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=PaletteSearch}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
       </Style>
      </Button.Style>
      <Path Data="M2,2 L9,9 M9,2 L2,9" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.4"/>
     </Button>
    </Grid>
    <Grid Grid.Row="1">
     <ListBox x:Name="PaletteList" input:PaletteDragBehavior.Enabled="{Binding Project.CanEdit}" IsEnabled="{Binding Project.CanEdit}"
              ItemsSource="{Binding Source={StaticResource GroupedPalette}}" SelectedItem="{Binding SelectedPaletteItem}"
              AutomationProperties.Name="Палитра компонентов">
      <ListBox.InputBindings>
       <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding PlaceComponentCommand}" CommandParameter="{Binding SelectedPaletteItem}"/>
       <KeyBinding Key="Enter" Command="{Binding PlaceComponentCommand}" CommandParameter="{Binding SelectedPaletteItem}"/>
      </ListBox.InputBindings>
      <ListBox.GroupStyle>
       <GroupStyle>
        <GroupStyle.HeaderTemplate>
         <DataTemplate>
          <TextBlock Text="{Binding Name}" Foreground="{DynamicResource MutedBrush}" FontSize="10.5" FontWeight="SemiBold"
                     TextWrapping="Wrap" Margin="7,11,4,4"/>
         </DataTemplate>
        </GroupStyle.HeaderTemplate>
       </GroupStyle>
      </ListBox.GroupStyle>
      <ListBox.ItemContainerStyle>
       <Style TargetType="ListBoxItem" BasedOn="{StaticResource PaletteRow}">
        <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
        <Setter Property="MinHeight" Value="52"/>
        <Setter Property="Cursor" Value="Hand"/>
       </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate>
       <DataTemplate>
        <Grid ToolTip="{Binding Description, StringFormat={}{0}&#10;Перетащите на холст}">
         <Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition/></Grid.ColumnDefinitions>
         <Border Width="52" Height="40" HorizontalAlignment="Left" CornerRadius="6" Padding="2"
                 BorderBrush="{DynamicResource SubtleLineBrush}" BorderThickness="1" Background="{DynamicResource RaisedBrush}">
          <Grid>
           <TextBlock Text="{Binding Symbol}" Foreground="{DynamicResource AccentHoverBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
           <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
          </Grid>
         </Border>
         <TextBlock Grid.Column="1" Text="{Binding Name}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12.5" Margin="0,2,4,2"/>
        </Grid>
       </DataTemplate>
      </ListBox.ItemTemplate>
     </ListBox>
     <TextBlock Text="Компоненты не найдены." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="6,10" IsHitTestVisible="False">
      <TextBlock.Style>
       <Style TargetType="TextBlock">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers><DataTrigger Binding="{Binding Items.Count,ElementName=PaletteList}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
       </Style>
      </TextBlock.Style>
     </TextBlock>
    </Grid>
    <Border Grid.Row="2" BorderBrush="{DynamicResource SubtleLineBrush}" BorderThickness="0,1,0,0" Padding="2,7,0,2">
     <Grid>
      <TextBlock Text="Перетащите компонент или выберите его двойным щелчком." Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap">
       <TextBlock.Style>
        <Style TargetType="TextBlock"><Style.Triggers>
         <DataTrigger Binding="{Binding Project.CanEdit}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
        </Style.Triggers></Style>
       </TextBlock.Style>
      </TextBlock>
      <StackPanel>
       <StackPanel.Style>
        <Style TargetType="StackPanel">
         <Setter Property="Visibility" Value="Collapsed"/>
         <Style.Triggers><DataTrigger Binding="{Binding Project.CanEdit}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
        </Style>
       </StackPanel.Style>
       <TextBlock Text="Остановите симуляцию, чтобы добавить компоненты." Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
       <Button Content="Стоп и редактировать" Style="{DynamicResource StopAction}" Command="{Binding Simulation.ResetCommand}"/>
      </StackPanel>
     </Grid>
    </Border>
   </Grid>
  </controls:DockPane>
 </Grid>
</UserControl>
