<UserControl x:Class="CircuitEditor.App.Views.OutputView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:input="clr-namespace:CircuitEditor.App.Interaction">
 <Grid Margin="6"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <WrapPanel><Button Content="Очистить" Command="{Binding ClearCommand}" Padding="8,4"/><Button Content="Копировать" Command="{Binding CopySelectedCommand}" Padding="8,4" Margin="6,0"/><CheckBox Content="Автопрокрутка" IsChecked="{Binding AutoScroll}" Margin="6,0"/><TextBlock Text="{Binding Feedback}" FontSize="9" Margin="8,0"/></WrapPanel>
  <ListBox Grid.Row="1" Background="{DynamicResource WorkSurfaceBrush}" ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}" input:OutputScrollBehavior.Model="{Binding}" Margin="0,5,0,0" FontFamily="{StaticResource MonoFont}" FontSize="12" AutomationProperties.Name="Вывод редактора">
   <ListBox.InputBindings><KeyBinding Key="C" Modifiers="Control" Command="{Binding CopySelectedCommand}"/></ListBox.InputBindings>
  </ListBox>
 </Grid>
</UserControl>
