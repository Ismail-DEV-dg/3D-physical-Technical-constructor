<UserControl x:Class="CircuitEditor.App.Views.OutputView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:input="clr-namespace:CircuitEditor.App.Interaction">
 <Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <WrapPanel><Button Content="Очистить" Command="{Binding ClearCommand}" Padding="8,4"/><Button Content="Копировать" Command="{Binding CopySelectedCommand}" Padding="8,4" Margin="6,0"/><CheckBox Content="Автопрокрутка" IsChecked="{Binding AutoScroll}" Margin="6,0"/><TextBlock Text="{Binding Feedback}" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" Margin="8,0"/></WrapPanel>
  <Border Grid.Row="1" Margin="0,7,0,0" Background="{DynamicResource WorkSurfaceBrush}" BorderBrush="{DynamicResource SubtleLineBrush}" BorderThickness="1" CornerRadius="6">
  <ListBox ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}" input:OutputScrollBehavior.Model="{Binding}" Padding="4" FontFamily="{StaticResource MonoFont}" FontSize="12" AutomationProperties.Name="Вывод редактора">
   <ListBox.InputBindings><KeyBinding Key="C" Modifiers="Control" Command="{Binding CopySelectedCommand}"/></ListBox.InputBindings>
  </ListBox>
  </Border>
 </Grid>
</UserControl>
