<UserControl x:Class="CircuitEditor.App.Views.OutputView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:input="clr-namespace:CircuitEditor.App.Interaction">
 <Grid Margin="6"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <WrapPanel><Button Content="Очистить" Command="{Binding ClearCommand}" Padding="8,4"/><CheckBox Content="Автопрокрутка" IsChecked="{Binding AutoScroll}" Margin="10,0"/><TextBlock Text="Системные сообщения · Serial Monitor пока не подключён" FontSize="9" VerticalAlignment="Center"/></WrapPanel>
  <ListBox Grid.Row="1" ItemsSource="{Binding Lines}" input:OutputScrollBehavior.Model="{Binding}" Margin="0,5,0,0" FontFamily="{StaticResource MonoFont}" FontSize="10" AutomationProperties.Name="Вывод редактора"/>
 </Grid>
</UserControl>
