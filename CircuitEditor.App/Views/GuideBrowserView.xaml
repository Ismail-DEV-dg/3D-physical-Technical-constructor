<UserControl x:Class="CircuitEditor.App.Views.GuideBrowserView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:input="clr-namespace:CircuitEditor.App.Interaction">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="VisibleIf"/></UserControl.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <Grid Margin="0,8,0,12">
   <TextBox x:Name="GuideSearch" Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}"
            AutomationProperties.Name="Поиск в пособии" ToolTip="Ctrl+F · поиск по названию, выводу и коду"/>
   <TextBlock Text="Поиск: светодиод, GPIO, 330 Ω, I²C…" IsHitTestVisible="False" Margin="12,0" VerticalAlignment="Center"
              Foreground="{DynamicResource MutedBrush}" FontSize="11">
    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
     <DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger>
    </Style.Triggers></Style></TextBlock.Style>
   </TextBlock>
  </Grid>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="226" MinWidth="170"/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Panel}" Background="{DynamicResource PanelBrush}" Padding="8">
   <DockPanel>
   <TextBlock DockPanel.Dock="Top" Text="Главы" FontSize="15" FontWeight="SemiBold" Margin="6,4,0,10"/>
   <ListBox ItemsSource="{Binding Chapters}" SelectedItem="{Binding Chapter}" AutomationProperties.Name="Главы пособия"
            input:KeepSelectedItemVisible.Enabled="True" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
    <ListBox.ItemContainerStyle>
     <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
      <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
     </Style>
    </ListBox.ItemContainerStyle>
    <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="13"/></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   </DockPanel>
   </Border>
   <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>
   <Grid Grid.Column="2" Margin="10,0,0,0">
    <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  input:ResetScrollOnChange.Value="{Binding Chapter}" AutomationProperties.Name="Содержимое главы">
     <StackPanel>
      <TextBlock Text="{Binding Chapter.Title}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="20" TextWrapping="Wrap" Margin="0,0,0,8"/>
      <TextBox Text="{Binding Chapter.Instructions, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
               VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" FontFamily="{StaticResource UiFont}" FontSize="14" Padding="13,12"
               Visibility="{Binding HasChapter, Converter={StaticResource VisibleIf}}" AutomationProperties.Name="Текст главы"/>
      <StackPanel Visibility="{Binding HasCode, Converter={StaticResource VisibleIf}}">
       <WrapPanel Margin="0,10,0,6">
        <Button Content="Копировать скетч" Margin="0,0,10,4" Command="{Binding CopyCodeCommand}" Padding="10,6"/>
        <StackPanel>
         <TextBlock Text="{Binding CodeHeading}" VerticalAlignment="Center" FontWeight="Bold"/>
         <TextBlock Text="{Binding Feedback}" Foreground="{DynamicResource AccentBrush}" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>
       </WrapPanel>
       <TextBox Text="{Binding Chapter.Code, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource MonoFont}"
                FontSize="12" TextWrapping="NoWrap" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto"
                AutomationProperties.Name="Пример скетча"/>
      </StackPanel>
      <TextBlock Text="Главы по запросу не найдены. Попробуйте одно слово, например «провод»." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap">
       <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
        <DataTrigger Binding="{Binding Chapter}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
       </Style.Triggers></Style></TextBlock.Style>
      </TextBlock>
     </StackPanel>
    </ScrollViewer>
    <DockPanel Grid.Row="1" Margin="0,10,0,0">
     <Button DockPanel.Dock="Left" Content="‹ Предыдущая" Command="{Binding PreviousCommand}" AutomationProperties.Name="Предыдущая глава"/>
     <Button DockPanel.Dock="Right" Content="Следующая ›" Command="{Binding NextCommand}" AutomationProperties.Name="Следующая глава"/>
     <TextBlock Text="{Binding ChapterPosition}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
    </DockPanel>
   </Grid>
  </Grid>
 </Grid>
</UserControl>
