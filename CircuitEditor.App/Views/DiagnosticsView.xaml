<UserControl x:Class="CircuitEditor.App.Views.DiagnosticsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources>
  <Style x:Key="DiagnosticMessage" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
    <Border x:Name="FocusLine" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}"><ScrollViewer x:Name="PART_ContentHost"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusLine" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </UserControl.Resources>
 <Grid Margin="6"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <WrapPanel>
   <Grid Width="170" Margin="0,0,6,4"><TextBox Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" Height="28" FontSize="10" Padding="7,4" ToolTip="Поиск по сообщению, коду и компоненту"/>
    <TextBlock Text="Поиск по проблемам…" Margin="10,0" FontSize="10" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
   </Grid>
   <ComboBox Width="105" Height="28" FontSize="10" ItemsSource="{Binding Sources}" SelectedItem="{Binding Source}" ToolTip="Схема / код / расчёт / все" Margin="0,0,6,4"/>
   <ComboBox Width="155" Height="28" FontSize="10" ItemsSource="{Binding Severities}" SelectedItem="{Binding Severity}" ToolTip="Уровень сообщения" Margin="0,0,6,4"/>
   <Button Content="Копировать список" Command="{Binding CopyAllCommand}" Padding="7,5" FontSize="10" Margin="0,0,6,4"/>
  </WrapPanel>
  <DockPanel Grid.Row="1" Margin="0,0,0,4"><TextBlock Text="{Binding Feedback}" DockPanel.Dock="Right" FontSize="10" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="{Binding Summary}" FontSize="10" Foreground="{DynamicResource MutedBrush}"/></DockPanel>
  <Grid Grid.Row="2">
   <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Проблемы схемы и кода">
    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Padding" Value="8,5"/><Setter Property="Margin" Value="0,0,0,4"/></Style></ListBox.ItemContainerStyle>
    <ListBox.InputBindings><KeyBinding Key="C" Modifiers="Control" Command="{Binding CopySelectedCommand}"/></ListBox.InputBindings>
    <ListBox.ItemTemplate><DataTemplate>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
       <TextBlock Text="{Binding Caption}" Foreground="{Binding Color}" FontSize="10"/>
       <TextBox Text="{Binding Message,Mode=OneWay}" Style="{StaticResource DiagnosticMessage}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0,4" FontSize="11" ToolTipService.InitialShowDelay="250" ToolTipService.ShowDuration="60000">
        <TextBox.ToolTip><ToolTip StaysOpen="True" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"><StackPanel Width="410">
         <TextBlock Text="{Binding Article.Title}" FontWeight="Bold" TextWrapping="Wrap"/>
         <TextBlock Text="{Binding Article.Cause}" TextWrapping="Wrap" Margin="0,7" FontSize="11"/>
         <TextBlock Text="{Binding Article.Fix}" TextWrapping="Wrap" FontSize="11"/>
         <Button Content="Открыть статью в справке" Command="{Binding HelpCommand}" Margin="0,10,0,0" Padding="8,5"/>
        </StackPanel></ToolTip></TextBox.ToolTip>
       </TextBox>
      </StackPanel>
      <StackPanel Grid.Column="1" Margin="8,0,0,0">
       <WrapPanel><Button Content="Копировать" Command="{Binding CopyCommand}" Padding="6,4" FontSize="9" Margin="0,0,4,0" ToolTip="Копировать полное сообщение"/><Button Content="Как исправить" Command="{Binding HelpCommand}" Padding="6,4" FontSize="9" ToolTip="Почему возникло и как исправить"/></WrapPanel>
       <Button Content="К месту ошибки" Command="{Binding NavigateCommand}" Padding="6,4" FontSize="9" Margin="0,4,0,0"/>
       <TextBlock Text="{Binding Feedback}" FontSize="9" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Feedback}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      </StackPanel>
     </Grid>
    </DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <TextBlock Text="По выбранным фильтрам проблем нет." Margin="12" FontSize="11" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False">
    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsEmpty}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
   </TextBlock>
  </Grid>
 </Grid>
</UserControl>
