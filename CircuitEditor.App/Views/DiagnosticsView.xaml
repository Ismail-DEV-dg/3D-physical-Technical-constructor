<UserControl x:Class="CircuitEditor.App.Views.DiagnosticsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources>
  <Style x:Key="DiagnosticMessage" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
   <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
   <Setter Property="FontSize" Value="13"/>
   <Setter Property="Padding" Value="0,2,0,3"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="TextBox">
      <Border x:Name="FocusLine" Background="Transparent" BorderBrush="Transparent"
              BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}">
       <ScrollViewer x:Name="PART_ContentHost" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusLine" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="IssueRow" TargetType="ListBoxItem">
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Border x:Name="Card" Background="{DynamicResource WorkSurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="1" CornerRadius="10" Margin="0,0,4,7">
     <ContentPresenter HorizontalAlignment="Stretch"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="{DynamicResource RaisedBrush}"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource PurpleBrush}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </UserControl.Resources>
 <Grid Margin="5,5,5,2">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <WrapPanel VerticalAlignment="Center">
   <Grid Width="162" Margin="0,0,5,4">
    <TextBox Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" MinHeight="32" FontSize="12" Padding="28,5,8,5"
             FontFamily="{StaticResource UiFont}" VerticalContentAlignment="Center" ToolTip="Поиск по сообщению, коду и компоненту"
             AutomationProperties.Name="Поиск по проблемам"/>
    <Path Data="M 8,4 A 4,4 0 1 1 0,4 A 4,4 0 1 1 8,4 M 7,7 L 11,11"
          Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.25" Margin="10,0,0,0" VerticalAlignment="Center"
          HorizontalAlignment="Left" IsHitTestVisible="False"/>
    <TextBlock Text="Найти проблему…" Margin="28,0,5,0" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" IsHitTestVisible="False">
     <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
      <DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger>
     </Style.Triggers></Style></TextBlock.Style>
    </TextBlock>
   </Grid>
   <ComboBox Width="105" MinHeight="32" FontSize="12" ItemsSource="{Binding Sources}" SelectedItem="{Binding Source}"
             ToolTip="Источник сообщения" AutomationProperties.Name="Источник сообщения" Margin="0,0,5,4"/>
   <ComboBox Width="135" MinHeight="32" FontSize="12" ItemsSource="{Binding Severities}" SelectedItem="{Binding Severity}"
             ToolTip="Уровень сообщения" AutomationProperties.Name="Уровень сообщения" Margin="0,0,5,4"/>
   <Button Style="{StaticResource QuietAction}" Content="Копировать список" Command="{Binding CopyAllCommand}"
           MinHeight="32" Padding="8,5" FontSize="11" Margin="0,0,0,4"/>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,4">
    <TextBlock Text="{Binding Summary}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
    <TextBlock Text="{Binding Feedback}" FontSize="11" Foreground="{DynamicResource AccentBrush}" Margin="6,0,0,0"/>
   </StackPanel>
  </WrapPanel>
  <Grid Grid.Row="1" Margin="0,2,0,0">
   <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" ItemContainerStyle="{StaticResource IssueRow}"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Проблемы проекта">
    <ListBox.InputBindings><KeyBinding Key="C" Modifiers="Control" Command="{Binding CopySelectedCommand}"/></ListBox.InputBindings>
    <ListBox.ItemTemplate><DataTemplate>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="3"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Background="{Binding Color}" CornerRadius="1.5" Margin="0,8"/>
      <Grid Grid.Column="1" Margin="11,8,9,6">
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <TextBlock Text="{Binding Caption}" Foreground="{Binding Color}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
       <TextBox Grid.Row="1" Text="{Binding Message, Mode=OneWay}" Style="{StaticResource DiagnosticMessage}"
                IsReadOnly="True" TextWrapping="Wrap" Margin="0,3,0,2"
                ToolTipService.InitialShowDelay="250" ToolTipService.ShowDuration="60000">
        <TextBox.ToolTip>
         <ToolTip StaysOpen="True" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
          <StackPanel Width="400">
           <TextBlock Text="{Binding Article.Title}" FontWeight="Bold" TextWrapping="Wrap"/>
           <TextBlock Text="{Binding Article.Cause}" TextWrapping="Wrap" Margin="0,7" FontSize="12"/>
           <TextBlock Text="{Binding Article.Fix}" TextWrapping="Wrap" FontSize="12"/>
           <Button Content="Открыть статью в справке" Command="{Binding HelpCommand}" Margin="0,10,0,0" Padding="8,5"/>
          </StackPanel>
         </ToolTip>
        </TextBox.ToolTip>
       </TextBox>
       <WrapPanel Grid.Row="2">
        <Button Style="{StaticResource PrimaryAction}" Content="Как исправить" Command="{Binding HelpCommand}" Padding="7,4" FontSize="11" Margin="0,0,5,0"/>
        <Button Style="{StaticResource QuietAction}" Content="К месту ошибки" Command="{Binding NavigateCommand}" Padding="7,4" FontSize="11"/>
        <Button Style="{StaticResource QuietAction}" Content="Копировать" Command="{Binding CopyCommand}" Padding="7,4" FontSize="11" ToolTip="Копировать полное сообщение"/>
        <TextBlock Text="{Binding Feedback}" FontSize="11" Foreground="{DynamicResource AccentBrush}" Margin="5,3,0,0"/>
       </WrapPanel>
      </Grid>
     </Grid>
    </DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <TextBlock Text="По выбранным фильтрам проблем нет." Margin="10" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False">
    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
     <DataTrigger Binding="{Binding IsEmpty}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
    </Style.Triggers></Style></TextBlock.Style>
   </TextBlock>
  </Grid>
 </Grid>
</UserControl>
