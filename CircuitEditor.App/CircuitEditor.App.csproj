<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\CircuitEditor.Core\CircuitEditor.Core.csproj" />
    <ProjectReference Include="..\CircuitEditor.Simulation\CircuitEditor.Simulation.csproj" />
    <ProjectReference Include="..\CircuitEditor.Infrastructure\CircuitEditor.Infrastructure.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>..\assets\branding\logo.ico</ApplicationIcon>
    <Product>Circuit Editor</Product>
    <Description>Редактор электрических схем для Arduino и ESP32</Description>
    <AssemblyTitle>$(Description)</AssemblyTitle>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <StartupObject>CircuitEditor.App.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <Content Include="..\Samples\*.*" Link="Samples\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Resource Include="..\assets\branding\logo.ico" Link="Branding\logo.ico" />
    <Resource Include="..\assets\branding\logo-256.png" Link="Branding\logo-256.png" />
    <Resource Include="Resources\Fonts\*.ttf" />
    <Content Include="Resources\Fonts\*.ttf" Link="Fonts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Resource Include="Resources\Components\*.jpg" />
    <Resource Include="Resources\Code\*.xshd" />
    <Content Include="..\CircuitEditor.Infrastructure\Data\**\*.json" Link="Data\%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\CircuitEditor.Infrastructure\Library\**\*.json" Link="Library\%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\LICENSE;..\THIRD-PARTY-NOTICES.md" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\licenses\**\*.*" Link="licenses\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="PublishHighlightingSources" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <HighlightingSource Include="Resources/Code/*.xshd" />
      <ResolvedFileToPublish Include="@(HighlightingSource)">
        <RelativePath>Code/%(HighlightingSource.Filename)%(HighlightingSource.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
  <Target Name="IncludeRuntimeLicenses" AfterTargets="ComputeFilesToPublish" Condition="'$(SelfContained)' == 'true'">
    <ItemGroup>
      <DesktopRuntimePack Include="@(ResolvedRuntimePack)" Condition="'%(ResolvedRuntimePack.NuGetPackageId)' == 'Microsoft.NETCore.App.Runtime.$(RuntimeIdentifier)' Or '%(ResolvedRuntimePack.NuGetPackageId)' == 'Microsoft.WindowsDesktop.App.Runtime.$(RuntimeIdentifier)'" />
      <RuntimeNotice Include="@(DesktopRuntimePack->'%(PackageDirectory)/LICENSE');@(DesktopRuntimePack->'%(PackageDirectory)/LICENSE.TXT');@(DesktopRuntimePack->'%(PackageDirectory)/THIRD-PARTY-NOTICES.TXT')" />
      <ResolvedFileToPublish Include="@(RuntimeNotice)" Condition="Exists('%(RuntimeNotice.Identity)')">
        <RelativePath>licenses/runtime/%(RuntimeNotice.NuGetPackageId)/%(RuntimeNotice.Filename)%(RuntimeNotice.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
