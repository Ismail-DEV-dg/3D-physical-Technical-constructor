<Window x:Class="CircuitEditor.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 Icon="pack://application:,,,/CircuitEditor.App;component/Branding/logo.ico"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 xmlns:vm="clr-namespace:CircuitEditor.App.ViewModels"
 xmlns:services="clr-namespace:CircuitEditor.App.Services"
 xmlns:views="clr-namespace:CircuitEditor.App.Views"
 xmlns:input="clr-namespace:CircuitEditor.App.Interaction"
 input:ProjectShortcutBehavior.Enabled="True" Title="{Binding Session.Title}" Width="1440" Height="900" MinWidth="830" MinHeight="500"
 UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" RenderOptions.BitmapScalingMode="HighQuality"
 WindowStartupLocation="CenterScreen" WindowStyle="SingleBorderWindow" ResizeMode="CanResize"
 Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}"
 FontFamily="{StaticResource UiFont}" FontSize="12">
    <Window.Resources>
        <Style x:Key="ExampleItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="Header" Value="{Binding Title}"/>
            <Setter Property="ToolTip" Value="{Binding Description}"/>
            <Setter Property="Command" Value="{Binding OpenCommand}"/>
            <Setter Property="CommandParameter" Value="{Binding Sample}"/>
        </Style>
    </Window.Resources>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>


    <Border x:Name="WindowFrame" BorderBrush="{DynamicResource SubtleLineBrush}" BorderThickness="1" Padding="0"
            Margin="{Binding Padding, RelativeSource={RelativeSource AncestorType=Window}}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/><RowDefinition Height="44"/>
                <RowDefinition Height="*"/><RowDefinition Height="26"/>
            </Grid.RowDefinitions>
            <Border Background="{DynamicResource ChromeBrush}"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="10,0,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0">
                        <Image Width="24" Height="24" Margin="0,0,9,0"
                               Source="pack://application:,,,/CircuitEditor.App;component/Branding/logo-256.png"/>
                        <TextBlock Text="Circuit Editor" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Menu Grid.Column="1" FontSize="12" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <MenuItem Header="_Файл">
                        <MenuItem Header="Новый проект" Command="{Binding Session.NewCommand}" ToolTip="{input:ShortcutHint New}"/>
                        <MenuItem Header="Открыть…" Command="{Binding Session.OpenCommand}" ToolTip="{input:ShortcutHint Open}"/>
                        <MenuItem Header="Сохранить" Command="{Binding Session.SaveCommand}" ToolTip="{input:ShortcutHint Save}"/>
                        <MenuItem Header="Сохранить как…" Command="{Binding Session.SaveAsCommand}" ToolTip="{input:ShortcutHint SaveAs}"/>
                        <MenuItem Header="Примеры" ItemsSource="{Binding Session.Samples}" ItemContainerStyle="{StaticResource ExampleItem}"/>
                        <MenuItem Header="Последние файлы" ItemsSource="{Binding Session.RecentFiles}">
                            <MenuItem.ItemContainerStyle><Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                <Setter Property="Header" Value="{Binding Path}"/><Setter Property="Command" Value="{Binding OpenCommand}"/>
                                <Setter Property="CommandParameter" Value="{Binding Path}"/>
                            </Style></MenuItem.ItemContainerStyle>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="Экспорт PNG…" Command="{Binding Exports.PngCommand}" ToolTip="{input:ShortcutHint Png}"/>
                        <MenuItem Header="Экспорт SVG схемы…" Command="{Binding Exports.SvgCommand}" ToolTip="{input:ShortcutHint Svg}"/>
                        <MenuItem Header="Ведомость деталей CSV…" Command="{Binding Exports.BomCommand}" ToolTip="{input:ShortcutHint Bom}"/>
                        <Separator/><MenuItem Header="Выход" Command="{Binding CloseCommand}"/>
                    </MenuItem>
                    <MenuItem Header="_Правка">
                        <MenuItem Header="Отменить" Command="{Binding UndoActiveCommand}" ToolTip="{input:ShortcutHint Undo}"/>
                        <MenuItem Header="Повторить" Command="{Binding RedoActiveCommand}" ToolTip="{input:ShortcutHint Redo}"/>
                        <Separator/>
                        <MenuItem Header="Копировать" Command="{Binding CopyActiveCommand}" ToolTip="{input:ShortcutHint Copy}"/>
                        <MenuItem Header="Вставить" Command="{Binding PasteActiveCommand}" ToolTip="{input:ShortcutHint Paste}"/>
                    </MenuItem>
                    <MenuItem Header="_Вид">
                        <MenuItem Header="Макет" ToolTip="{input:ShortcutHint Tab0}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:WorkspaceKind.Mockup}"/>
                        <MenuItem Header="Схема" ToolTip="{input:ShortcutHint Tab1}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:WorkspaceKind.Schematic}"/>
                        <MenuItem Header="Микросхема" ToolTip="{input:ShortcutHint Tab3}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:WorkspaceKind.Chip}"/>
                        <MenuItem Header="Код" ToolTip="{input:ShortcutHint Tab2}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:WorkspaceKind.Code}"/>
                        <Separator/>
                        <MenuItem Header="Панели">
                            <MenuItem Header="Компоненты" Command="{Binding Panels.Components.ShowCommand}"/>
                            <MenuItem Header="Свойства" Command="{Binding Panels.Inspector.ShowCommand}"/>
                            <MenuItem Header="Нижняя панель" Command="{Binding Panels.Analysis.ShowCommand}"/>
                            <Separator/><MenuItem Header="Восстановить расположение панелей" Command="{Binding Panels.ResetCommand}"/>
                        </MenuItem>
                        <MenuItem Header="Тема">
                            <MenuItem Header="Neon Dark" Command="{Binding SetThemeCommand}" CommandParameter="{x:Static services:ThemeKind.NeonDark}"/>
                            <MenuItem Header="Light Tech" Command="{Binding SetThemeCommand}" CommandParameter="{x:Static services:ThemeKind.LightTech}"/>
                        </MenuItem>
                    </MenuItem>
                    <MenuItem Header="_Схема">
                        <MenuItem Header="Калькулятор…" Command="{Binding CalculatorCommand}" ToolTip="{input:ShortcutHint Calculator}"/>
                        <MenuItem Header="Рассчитать цепь" Command="{Binding Analysis.CalculateCommand}" ToolTip="{input:ShortcutHint Calculate}"/>
                        <MenuItem Header="Проверить соединения" Command="{Binding Analysis.CheckCommand}" ToolTip="{input:ShortcutHint Check}"/>
                        <MenuItem Header="{Binding Simulation.SketchPlaybackAction}" Command="{Binding Simulation.ToggleSketchCommand}" ToolTip="{input:ShortcutHint RunSketch}"/>
                    </MenuItem>
                    <MenuItem Header="_Справка">
                        <MenuItem Header="Документация…" Command="{Binding DocumentationCommand}"/>
                        <MenuItem Header="Учебные примеры" ItemsSource="{Binding Session.Samples}" ItemContainerStyle="{StaticResource ExampleItem}"/>
                        <Separator/>
                        <MenuItem Header="Горячие клавиши…" ToolTip="{input:ShortcutHint Help}" Command="{Binding ShortcutHelpCommand}"/>
                        <MenuItem Header="Показать все компоненты" Command="{Binding ShowAllComponentsCommand}"/>
                        <MenuItem Header="О программе" Command="{Binding AboutCommand}"/>
                    </MenuItem>
                </Menu>
                    <Grid Grid.Column="2" Margin="18,0,12,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Path Data="M2,1 H8 L12,5 V14 H2 Z M8,1 V5 H12" Width="11" Height="13" Stretch="Uniform"
                              Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.1" Margin="0,0,7,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding Session.ProjectName}" ToolTip="{Binding Session.ProjectName}"
                                   Foreground="{DynamicResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}" Command="{Binding MinimizeCommand}" ToolTip="Свернуть" AutomationProperties.Name="Свернуть">
                        <Path Data="M 0,4 L 10,4" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.3"/>
                    </Button>
                    <Button Style="{StaticResource CaptionButton}" Command="{Binding ToggleMaximizeCommand}" ToolTip="Развернуть / восстановить" AutomationProperties.Name="Развернуть">
                        <Path Data="M 0,0 L 10,0 10,9 0,9 Z" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.2"/>
                    </Button>
                    <Button Style="{DynamicResource CloseCaptionButton}" Command="{Binding CloseCommand}" ToolTip="Закрыть" AutomationProperties.Name="Закрыть">
                        <Path Data="M 0,0 L 10,10 M 0,10 L 10,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"/>
                    </Button>
                </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Row="1" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource SubtleLineBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TabControl x:Name="WorkspaceChooser" Grid.ColumnSpan="3" HorizontalAlignment="Center" VerticalAlignment="Center" ItemsSource="{Binding Workspaces}" SelectedItem="{Binding SelectedWorkspace,Mode=TwoWay}"
                            Style="{StaticResource WorkspaceTabs}" ItemContainerStyle="{StaticResource GlassWorkspaceTab}"
                            AutomationProperties.Name="Рабочие пространства">
                    <TabControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}"/></DataTemplate></TabControl.ItemTemplate>
                </TabControl>
                <StackPanel x:Name="SimulationTransport" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{DynamicResource RunAction}" Command="{Binding Simulation.ToggleSketchCommand}" Margin="0,0,5,0" ToolTip="{Binding Simulation.SketchPlaybackAction}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock>
                                <TextBlock.Style><Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="▶ Запустить"/>
                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Simulation.IsSketchRunning}" Value="True"><Setter Property="Text" Value="Ⅱ Пауза"/></DataTrigger>
                                    </Style.Triggers>
                                </Style></TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                    <Button Style="{DynamicResource StopAction}" Content="■ Стоп" Command="{Binding Simulation.ResetCommand}"/>
                </StackPanel>
            </Grid>
            </Border>
            <views:EditorLayoutView x:Name="EditorLayout" Grid.Row="2" Margin="8,8,8,5"/>
            <Border Grid.Row="3" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource SubtleLineBrush}" BorderThickness="0,1,0,0">
                <Grid x:Name="StatusArea" Margin="10,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <DockPanel Margin="0,0,8,0">
                        <Ellipse DockPanel.Dock="Left" Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" Margin="0,0,7,0"/>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource MutedBrush}" FontSize="11"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding StatusMessage}"/>
                    </DockPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" TextElement.FontFamily="{StaticResource ReadoutFont}">
                        <TextBlock Text="{Binding Code.CursorStatus}" Foreground="{DynamicResource AccentHoverBrush}" FontSize="11" Margin="0,0,9,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding SelectedWorkspace.Kind}" Value="{x:Static vm:WorkspaceKind.Code}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger></Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button x:Name="ErcStatus" AutomationProperties.Name="Проблемы и расчёты" Command="{Binding Panels.ToggleAnalysisCommand}"
                                ToolTip="Показать или свернуть проблемы и расчёты" Padding="7,2" Style="{StaticResource QuietAction}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="5" Height="5" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Analysis.IsPending}" Value="True"><Setter Property="Fill" Value="{DynamicResource MutedBrush}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding Analysis.HasWarnings}" Value="True"><Setter Property="Fill" Value="{DynamicResource WarningBrush}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding Analysis.HasErrors}" Value="True"><Setter Property="Fill" Value="{DynamicResource DangerBrush}"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding Analysis.CountSummary,TargetNullValue=ERC,FallbackValue=ERC}" Style="{StaticResource MutedText}"/>
                            </StackPanel>
                        </Button>
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers><DataTrigger Binding="{Binding IsCanvas}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger></Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border Width="1" Height="12" Background="{DynamicResource LineBrush}" Margin="4,0,7,0"/>
                            <TextBlock Text="{Binding CursorX, StringFormat=X: {0:0.##}}" Style="{StaticResource MutedText}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CursorY, StringFormat=Y: {0:0.##}}" Style="{StaticResource MutedText}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CoordinateUnit}" Style="{StaticResource MutedText}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <Border Width="1" Height="12" Background="{DynamicResource LineBrush}" Margin="2,0,3,0"/>
                            <Menu AutomationProperties.Name="Масштаб">
                                <MenuItem Padding="7,1" ToolTip="Масштаб холста">
                                    <MenuItem.Header><TextBlock Text="{Binding ZoomPercent, StringFormat={}{0:0}%}" Style="{StaticResource MutedText}"
                                                                Foreground="{DynamicResource AccentHoverBrush}"/></MenuItem.Header>
                                    <MenuItem Header="50 %" Command="{Binding SetZoomCommand}" CommandParameter="50"/>
                                    <MenuItem Header="75 %" Command="{Binding SetZoomCommand}" CommandParameter="75"/>
                                    <MenuItem Header="100 %" Command="{Binding SetZoomCommand}" CommandParameter="100"/>
                                    <MenuItem Header="150 %" Command="{Binding SetZoomCommand}" CommandParameter="150"/>
                                    <MenuItem Header="200 %" Command="{Binding SetZoomCommand}" CommandParameter="200"/>
                                </MenuItem>
                            </Menu>
                        </StackPanel>
                        <Border Width="1" Height="12" Background="{DynamicResource LineBrush}" Margin="4,0,8,0"/>
                        <TextBlock Text="{Binding ComponentCount, StringFormat=Компонентов: {0}}" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
            <views:StartupView Grid.RowSpan="4" Panel.ZIndex="10"/>
        </Grid>
    </Border>
    <Window.Style><Style TargetType="Window"><Style.Triggers>
        <Trigger Property="WindowState" Value="Maximized"><Setter Property="Padding" Value="8"/></Trigger>
    </Style.Triggers></Style></Window.Style>
</Window>
