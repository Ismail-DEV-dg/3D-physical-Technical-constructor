<Window x:Class="CircuitEditor.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 xmlns:vm="clr-namespace:CircuitEditor.App.ViewModels"
 xmlns:services="clr-namespace:CircuitEditor.App.Services"
 xmlns:views="clr-namespace:CircuitEditor.App.Views"
 xmlns:input="clr-namespace:CircuitEditor.App.Interaction"
 input:ProjectShortcutBehavior.Enabled="True" Title="{Binding Session.Title}" Width="1440" Height="900" MinWidth="1120" MinHeight="680"
 WindowStartupLocation="CenterScreen" WindowStyle="SingleBorderWindow" ResizeMode="CanResize"
 Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}"
 FontFamily="{StaticResource UiFont}" FontSize="12">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>


    <Border x:Name="WindowFrame" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="8"
            Margin="{Binding Padding, RelativeSource={RelativeSource AncestorType=Window}}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/><RowDefinition Height="60"/>
                <RowDefinition Height="*"/><RowDefinition Height="32"/>
            </Grid.RowDefinitions>
            <Border Background="{DynamicResource ChromeBrush}" CornerRadius="8,8,0,0"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="12,0,5,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,22,0">
                        <Border Background="{DynamicResource ActiveSurfaceBrush}" CornerRadius="7" Width="30" Height="30" Margin="0,0,9,0">
                            <Path Data="M 4,8 L 8,8 8,4 15,4 15,12 20,12 M 4,16 L 11,16 11,9 19,9 M 8,4 A 1.5,1.5 0 1 0 8,1"
                                  Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" Width="18" Height="18" Stretch="Uniform"/>
                        </Border>
                        <TextBlock Text="Circuit Editor" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Menu Grid.Column="1" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <MenuItem Header="_Файл">
                        <MenuItem Header="Новый проект" Command="{Binding Session.NewCommand}" ToolTip="{input:ShortcutHint New}"/>
                        <MenuItem Header="Открыть…" Command="{Binding Session.OpenCommand}" ToolTip="{input:ShortcutHint Open}"/>
                        <MenuItem Header="Сохранить" Command="{Binding Session.SaveCommand}" ToolTip="{input:ShortcutHint Save}"/>
                        <MenuItem Header="Сохранить как…" Command="{Binding Session.SaveAsCommand}" ToolTip="{input:ShortcutHint SaveAs}"/>
                        <MenuItem Header="Последние файлы" ItemsSource="{Binding Session.RecentFiles}">
                            <MenuItem.ItemContainerStyle><Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                <Setter Property="Header" Value="{Binding Path}"/><Setter Property="Command" Value="{Binding OpenCommand}"/>
                                <Setter Property="CommandParameter" Value="{Binding Path}"/>
                            </Style></MenuItem.ItemContainerStyle>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="Экспорт PNG…" Command="{Binding Exports.PngCommand}" ToolTip="{input:ShortcutHint Png}"/>
                        <MenuItem Header="Экспорт SVG схемы…" Command="{Binding Exports.SvgCommand}" ToolTip="{input:ShortcutHint Svg}"/>
                        <MenuItem Header="Ведомость деталей CSV…" Command="{Binding Exports.BomCommand}" ToolTip="{input:ShortcutHint Bom}"/>
                        <Separator/><MenuItem Header="Выход" Command="{Binding CloseCommand}"/>
                    </MenuItem>
                    <MenuItem Header="_Правка">
                        <MenuItem Header="Отменить" Command="{Binding UndoActiveCommand}" ToolTip="{input:ShortcutHint Undo}"/>
                        <MenuItem Header="Повторить" Command="{Binding RedoActiveCommand}" ToolTip="{input:ShortcutHint Redo}"/>
                        <Separator/>
                        <MenuItem Header="Копировать · Ctrl+C" Command="{Binding CopyActiveCommand}" ToolTip="{input:ShortcutHint Copy}"/>
                        <MenuItem Header="Вставить · Ctrl+V" Command="{Binding PasteActiveCommand}" ToolTip="{input:ShortcutHint Paste}"/>
                    </MenuItem>
                    <MenuItem Header="_Вид">
                        <MenuItem Header="Вписать проект в холст" InputGestureText="F / Home" Command="{Binding FitViewCommand}" ToolTip="{input:ShortcutHint Fit}"/>
                        <MenuItem Header="Макет · Ctrl+0" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:WorkspaceKind.Mockup}"/>
                        <MenuItem Header="Схема  ·  Ctrl+1" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:WorkspaceKind.Schematic}"/>
                        <MenuItem Header="Микросхема  ·  Ctrl+2" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:WorkspaceKind.Chip}"/>
                        <MenuItem Header="3D  ·  Ctrl+3" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:WorkspaceKind.ThreeD}"/>
                        <MenuItem Header="Код  ·  Ctrl+4" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:WorkspaceKind.Code}"/>
                        <Separator/>
                        <MenuItem Header="Панели">
                            <MenuItem Header="Компоненты" Command="{Binding Panels.Components.ShowCommand}"/>
                            <MenuItem Header="Свойства" Command="{Binding Panels.Inspector.ShowCommand}"/>
                            <MenuItem Header="Нижняя панель" Command="{Binding Panels.Analysis.ShowCommand}"/>
                            <Separator/><MenuItem Header="Восстановить расположение панелей" Command="{Binding Panels.ResetCommand}"/>
                        </MenuItem>
                        <MenuItem Header="Тема">
                            <MenuItem Header="Neon Dark" Command="{Binding SetThemeCommand}" CommandParameter="{x:Static services:ThemeKind.NeonDark}"/>
                            <MenuItem Header="Light Tech" Command="{Binding SetThemeCommand}" CommandParameter="{x:Static services:ThemeKind.LightTech}"/>
                        </MenuItem>
                    </MenuItem>
                    <MenuItem Header="_Схема">
                        <MenuItem Header="Калькулятор…" Command="{Binding CalculatorCommand}" ToolTip="{input:ShortcutHint Calculator}"/>
                        <MenuItem Header="Рассчитать цепь" Command="{Binding Analysis.CalculateCommand}" ToolTip="{input:ShortcutHint Calculate}"/>
                        <MenuItem Header="Проверить соединения" Command="{Binding Analysis.CheckCommand}" ToolTip="{input:ShortcutHint Check}"/>
                        <MenuItem Header="Запустить симуляцию" Command="{Binding ExplainCommand}" CommandParameter="Симуляция"/>
                    </MenuItem>
                    <MenuItem Header="_Справка">
                        <MenuItem Header="Документация…" Command="{Binding DocumentationCommand}"/>
                        <Separator/>
                        <MenuItem Header="Горячие клавиши…" InputGestureText="F1" Command="{Binding ShortcutHelpCommand}"/>
                        <MenuItem Header="Показать все компоненты" Command="{Binding ShowAllComponentsCommand}"/>
                        <MenuItem Header="О программе" Command="{Binding AboutCommand}"/>
                    </MenuItem>
                </Menu>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}" Command="{Binding MinimizeCommand}" ToolTip="Свернуть" AutomationProperties.Name="Свернуть">
                        <Path Data="M 0,4 L 10,4" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.3"/>
                    </Button>
                    <Button Style="{StaticResource CaptionButton}" Command="{Binding ToggleMaximizeCommand}" ToolTip="Развернуть / восстановить" AutomationProperties.Name="Развернуть">
                        <Path Data="M 0,0 L 10,0 10,9 0,9 Z" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.2"/>
                    </Button>
                    <Button Style="{StaticResource CaptionButton}" Command="{Binding CloseCommand}" ToolTip="Закрыть" AutomationProperties.Name="Закрыть">
                        <Path Data="M 0,0 L 10,10 M 0,10 L 10,0" Stroke="{DynamicResource RedBrush}" StrokeThickness="1.4"/>
                    </Button>
                </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Row="1" Background="{DynamicResource TitleSurfaceBrush}" CornerRadius="10" Margin="0,3,0,7" Padding="14,0">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Stroke="{DynamicResource PurpleBrush}" StrokeThickness="1.45" Data="M 1,1 H 9 L 14,6 V 17 H 1 Z M 9,1 V 6 H 14 M 4,9 H 11 M 4,12 H 11"
                          Width="14" Height="17" Stretch="Uniform" Margin="0,0,9,0"/>
                    <TextBlock Text="{Binding Session.Title}" ToolTip="{Binding Session.Title}" TextTrimming="CharacterEllipsis"
                               MaxWidth="390" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Открыть" Command="{Binding Session.OpenCommand}" ToolTip="{input:ShortcutHint Open}" Style="{StaticResource QuietAction}" Margin="0,0,4,0"/>
                    <Button Content="Сохранить" Command="{Binding Session.SaveCommand}" ToolTip="{input:ShortcutHint Save}" Style="{StaticResource PrimaryAction}" Margin="0,0,4,0"/>
                    <Button Content="Вписать" Command="{Binding FitViewCommand}" ToolTip="{input:ShortcutHint Fit}">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource QuietAction}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedWorkspace.Kind}" Value="{x:Static vm:WorkspaceKind.Mockup}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                <DataTrigger Binding="{Binding SelectedWorkspace.Kind}" Value="{x:Static vm:WorkspaceKind.Schematic}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                            </Style.Triggers>
                        </Style></Button.Style>
                    </Button>
                    <Border Background="{DynamicResource LineBrush}" Width="1" Margin="10,6"/>
                    <ComboBox Width="122" SelectedValuePath="Tag" SelectedValue="{Binding SelectedTheme, Mode=TwoWay}" AutomationProperties.Name="Тема интерфейса">
                        <ComboBoxItem Content="Neon Dark" Tag="{x:Static services:ThemeKind.NeonDark}"/>
                        <ComboBoxItem Content="Light Tech" Tag="{x:Static services:ThemeKind.LightTech}"/>
                    </ComboBox>
                    <Button Command="{Binding ToggleThemeCommand}" Margin="5,0,0,0" Style="{StaticResource QuietAction}" ToolTip="Переключить тему" AutomationProperties.Name="Переключить тему">
                        <Path Data="M 8,0 L 8,3 M 8,13 L 8,16 M 0,8 L 3,8 M 13,8 L 16,8 M 2,2 L 4,4 M 12,12 L 14,14 M 2,14 L 4,12 M 12,4 L 14,2 M 11,8 A 3,3 0 1 1 5,8 A 3,3 0 1 1 11,8"
                              Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.2" Width="15" Height="15"/>
                    </Button>
                </StackPanel>
            </Grid>
            </Border>
            <views:EditorLayoutView x:Name="EditorLayout" Grid.Row="2" Margin="0"/>
            <Grid Grid.Row="3" Margin="8,4,8,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="5" Height="5" Fill="{DynamicResource GreenBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="10" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" MaxWidth="480" ToolTip="{Binding StatusMessage}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Code.CursorStatus}" Foreground="{DynamicResource AccentBrush}" FontSize="10" Margin="0,0,14,0">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedWorkspace.Kind}" Value="{x:Static vm:WorkspaceKind.Code}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                        </Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding Analysis.CountSummary}" Style="{StaticResource MutedText}" Margin="0,0,10,0"/>
                    <StackPanel Orientation="Horizontal"><StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedWorkspace.Kind}" Value="{x:Static vm:WorkspaceKind.Code}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                    </Style.Triggers></Style></StackPanel.Style>
                    <TextBlock Text="{Binding CursorX, StringFormat=X: {0:0.##}}" Style="{StaticResource MutedText}" Margin="0,0,14,0"/>
                    <TextBlock Text="{Binding CursorY, StringFormat=Y: {0:0.##}}" Style="{StaticResource MutedText}" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding CoordinateUnit}" Style="{StaticResource MutedText}" Margin="0,0,18,0"/>
                    <TextBlock Text="{Binding ZoomPercent, StringFormat={}{0:0}%}" Foreground="{DynamicResource AccentBrush}" FontSize="10" Margin="0,0,22,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding ComponentCount, StringFormat=Компонентов: {0}}" Style="{StaticResource MutedText}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
    <Window.Style><Style TargetType="Window"><Style.Triggers>
        <Trigger Property="WindowState" Value="Maximized"><Setter Property="Padding" Value="8"/></Trigger>
    </Style.Triggers></Style></Window.Style>
</Window>
