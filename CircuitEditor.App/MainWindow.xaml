<Window x:Class="CircuitEditor.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 xmlns:vm="clr-namespace:CircuitEditor.App.ViewModels"
 xmlns:services="clr-namespace:CircuitEditor.App.Services"
 Title="Circuit Editor — Arduino / ESP32" Width="1440" Height="900" MinWidth="1120" MinHeight="680"
 WindowStartupLocation="CenterScreen" WindowStyle="SingleBorderWindow" ResizeMode="CanResize"
 Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}"
 FontFamily="{StaticResource UiFont}" FontSize="12">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="D1" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:WorkspaceKind.Schematic}"/>
        <KeyBinding Modifiers="Control" Key="D2" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:WorkspaceKind.Chip}"/>
        <KeyBinding Modifiers="Control" Key="D3" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:WorkspaceKind.ThreeD}"/>
        <KeyBinding Modifiers="Control" Key="D4" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:WorkspaceKind.Code}"/>
    </Window.InputBindings>
    <Border x:Name="WindowFrame" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="8"
            Margin="{Binding Padding, RelativeSource={RelativeSource AncestorType=Window}}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/><RowDefinition Height="38"/><RowDefinition Height="64"/>
                <RowDefinition Height="*"/><RowDefinition Height="38"/>
            </Grid.RowDefinitions>
            <Grid Margin="14,0,8,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="M 2,8 L 8,8 8,2 22,2 22,8 28,8 M 2,20 L 8,20 8,26 22,26 22,20 28,20 M 8,8 L 22,8 22,20 8,20 Z"
                          Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6" Width="30" Height="30" Stretch="Uniform" Margin="0,0,12,0"/>
                    <TextBlock Text="CIRCUIT" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text=" / EDITOR" Foreground="{DynamicResource AccentBrush}" FontSize="18" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource RaisedBrush}" CornerRadius="4" Margin="18,0,0,0" Padding="8,4" VerticalAlignment="Center">
                        <TextBlock Text="ARDUINO + ESP32" Style="{StaticResource MutedText}"/>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}" Command="{Binding MinimizeCommand}" ToolTip="Свернуть" AutomationProperties.Name="Свернуть">
                        <Path Data="M 0,4 L 10,4" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.3"/>
                    </Button>
                    <Button Style="{StaticResource CaptionButton}" Command="{Binding ToggleMaximizeCommand}" ToolTip="Развернуть / восстановить" AutomationProperties.Name="Развернуть">
                        <Path Data="M 0,0 L 10,0 10,9 0,9 Z" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.2"/>
                    </Button>
                    <Button Style="{StaticResource CaptionButton}" Command="{Binding CloseCommand}" ToolTip="Закрыть" AutomationProperties.Name="Закрыть">
                        <Path Data="M 0,0 L 10,10 M 0,10 L 10,0" Stroke="{DynamicResource RedBrush}" StrokeThickness="1.4"/>
                    </Button>
                </StackPanel>
            </Grid>
            <Border Grid.Row="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Margin="10,0">
                <Menu VerticalAlignment="Center">
                    <MenuItem Header="_Файл">
                        <MenuItem Header="Новый проект" Command="{Binding ExplainCommand}" CommandParameter="Новый проект"/>
                        <MenuItem Header="Открыть…" Command="{Binding ExplainCommand}" CommandParameter="Открытие"/>
                        <MenuItem Header="Сохранить" Command="{Binding ExplainCommand}" CommandParameter="Сохранение"/>
                        <Separator/><MenuItem Header="Выход" Command="{Binding CloseCommand}"/>
                    </MenuItem>
                    <MenuItem Header="_Правка">
                        <MenuItem Header="Отменить" Command="{Binding ExplainCommand}" CommandParameter="Отмена"/>
                        <MenuItem Header="Повторить" Command="{Binding ExplainCommand}" CommandParameter="Повтор"/>
                    </MenuItem>
                    <MenuItem Header="_Вид">
                        <MenuItem Header="Схема  ·  Ctrl+1" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:WorkspaceKind.Schematic}"/>
                        <MenuItem Header="Микросхема  ·  Ctrl+2" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:WorkspaceKind.Chip}"/>
                        <MenuItem Header="3D  ·  Ctrl+3" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:WorkspaceKind.ThreeD}"/>
                        <MenuItem Header="Код  ·  Ctrl+4" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:WorkspaceKind.Code}"/>
                        <Separator/>
                        <MenuItem Header="Тема">
                            <MenuItem Header="Neon Dark" Command="{Binding SetThemeCommand}" CommandParameter="{x:Static services:ThemeKind.NeonDark}"/>
                            <MenuItem Header="Light Tech" Command="{Binding SetThemeCommand}" CommandParameter="{x:Static services:ThemeKind.LightTech}"/>
                        </MenuItem>
                    </MenuItem>
                    <MenuItem Header="_Схема">
                        <MenuItem Header="Проверить соединения" Command="{Binding ExplainCommand}" CommandParameter="Проверка схемы"/>
                        <MenuItem Header="Запустить симуляцию" Command="{Binding ExplainCommand}" CommandParameter="Симуляция"/>
                    </MenuItem>
                    <MenuItem Header="_Справка"><MenuItem Header="О программе" Command="{Binding AboutCommand}"/></MenuItem>
                </Menu>
            </Border>
            <Grid Grid.Row="2" Margin="14,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="3" Height="30" Background="{DynamicResource AccentBrush}" Margin="0,0,12,0"/>
                    <StackPanel><TextBlock Text="Новый проект" FontSize="16" FontWeight="Bold"/><TextBlock Text="Локальное рабочее пространство" Style="{StaticResource MutedText}" Margin="0,4,0,0"/></StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="ОФОРМЛЕНИЕ" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <ComboBox Width="170" SelectedValuePath="Tag" SelectedValue="{Binding SelectedTheme, Mode=TwoWay}" AutomationProperties.Name="Тема интерфейса">
                        <ComboBoxItem Content="Neon Dark" Tag="{x:Static services:ThemeKind.NeonDark}"/>
                        <ComboBoxItem Content="Light Tech" Tag="{x:Static services:ThemeKind.LightTech}"/>
                    </ComboBox>
                    <Button Command="{Binding ToggleThemeCommand}" Margin="10,0,0,0" ToolTip="Переключить тему" AutomationProperties.Name="Переключить тему" Padding="10">
                        <Path Data="M 8,0 L 8,3 M 8,13 L 8,16 M 0,8 L 3,8 M 13,8 L 16,8 M 2,2 L 4,4 M 12,12 L 14,14 M 2,14 L 4,12 M 12,4 L 14,2 M 11,8 A 3,3 0 1 1 5,8 A 3,3 0 1 1 11,8" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.2" Width="16" Height="16"/>
                    </Button>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="3" Margin="10,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="236"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Panel}">
                    <Grid Margin="14">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="КОМПОНЕНТЫ" FontWeight="Bold" FontSize="12"/>
                        <TextBlock Grid.Row="1" Text="Библиотека / 05" Style="{StaticResource MutedText}" Margin="0,8,0,22"/>
                        <ListBox Grid.Row="2" ItemsSource="{Binding Palette}" SelectedItem="{Binding SelectedPaletteItem}" AutomationProperties.Name="Палитра компонентов">
                            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                            </Style></ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate><DataTemplate>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="4" Width="26" Height="30" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Symbol}" Foreground="{DynamicResource AccentBrush}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontSize="11"/>
                                        <TextBlock Text="{Binding Category}" Foreground="{DynamicResource MutedBrush}" FontSize="8" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <Border Grid.Row="3" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,2">
                            <TextBlock Text="Выберите карточку, чтобы&#10;посмотреть описание." Foreground="{DynamicResource MutedBrush}" FontSize="10" LineHeight="18"/>
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Panel}" ClipToBounds="True">
                    <TabControl ItemsSource="{Binding Workspaces}" SelectedItem="{Binding SelectedWorkspace, Mode=TwoWay}" AutomationProperties.Name="Рабочие пространства">
                        <TabControl.ItemContainerStyle><Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                            <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
                        </Style></TabControl.ItemContainerStyle>
                        <TabControl.ItemTemplate><DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Index}" FontSize="9" Foreground="{DynamicResource PurpleBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Title}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" FontSize="11"/>
                            </StackPanel>
                        </DataTemplate></TabControl.ItemTemplate>
                    </TabControl>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource Panel}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="16">
                            <TextBlock Text="СВОЙСТВА" FontWeight="Bold"/>
                            <TextBlock Text="Инспектор компонента" Style="{StaticResource MutedText}" Margin="0,8,0,24"/>
                            <Border BorderBrush="{DynamicResource PurpleBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
                                <TextBlock Text="i" Foreground="{DynamicResource PurpleBrush}" FontSize="22" HorizontalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="0,18,0,0">
                                <StackPanel.Style><Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding HasPaletteSelection}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                </Style></StackPanel.Style>
                                <TextBlock Text="Ничего не выбрано" FontSize="12" TextWrapping="Wrap"/>
                                <TextBlock Text="Выберите компонент в палитре слева. Его описание появится здесь." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="21"/>
                            </StackPanel>
                            <StackPanel Margin="0,18,0,0">
                                <StackPanel.Style><Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding HasPaletteSelection}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                </Style></StackPanel.Style>
                                <TextBlock Text="НАЗВАНИЕ" Style="{StaticResource MutedText}" Margin="0,0,0,8"/>
                                <TextBox Text="{Binding SelectedPaletteItem.Name, Mode=OneWay}" IsReadOnly="True" FontSize="11" AutomationProperties.Name="Название компонента"/>
                                <TextBlock Text="{Binding SelectedPaletteItem.Category}" Foreground="{DynamicResource AccentBrush}" FontSize="9" Margin="0,16,0,10"/>
                                <TextBlock Text="{Binding SelectedPaletteItem.Description}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" LineHeight="22"/>
                            </StackPanel>
                            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,24,0,0" Padding="0,16,0,0">
                                <TextBlock Text="Параметры и редактирование&#10;появятся на следующих этапах." Foreground="{DynamicResource MutedBrush}" FontSize="9" TextWrapping="Wrap" LineHeight="18"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
            <Grid Grid.Row="4" Margin="18,8,18,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="5" Height="5" Fill="{DynamicResource GreenBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="10" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" MaxWidth="480" ToolTip="{Binding StatusMessage}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CursorX, StringFormat=X: {0:0}}" Style="{StaticResource MutedText}" Margin="0,0,14,0"/>
                    <TextBlock Text="{Binding CursorY, StringFormat=Y: {0:0}}" Style="{StaticResource MutedText}" Margin="0,0,22,0"/>
                    <TextBlock Text="{Binding ZoomPercent, StringFormat={}{0:0}%}" Foreground="{DynamicResource AccentBrush}" FontSize="10" Margin="0,0,22,0"/>
                    <TextBlock Text="{Binding ComponentCount, StringFormat=Компонентов: {0}}" Style="{StaticResource MutedText}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
    <Window.Style><Style TargetType="Window"><Style.Triggers>
        <Trigger Property="WindowState" Value="Maximized"><Setter Property="Padding" Value="8"/></Trigger>
    </Style.Triggers></Style></Window.Style>
</Window>
