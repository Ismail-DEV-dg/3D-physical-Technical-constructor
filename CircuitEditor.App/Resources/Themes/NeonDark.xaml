<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="BackgroundColor">#111419</Color>
    <SolidColorBrush x:Key="BackgroundBrush" Color="{DynamicResource BackgroundColor}"/>
    <Color x:Key="PanelColor">#161A21</Color>
    <SolidColorBrush x:Key="PanelBrush" Color="{DynamicResource PanelColor}"/>
    <Color x:Key="RaisedColor">#1D222B</Color>
    <SolidColorBrush x:Key="RaisedBrush" Color="{DynamicResource RaisedColor}"/>
    <Color x:Key="HoverColor">#252C37</Color>
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}"/>
    <Color x:Key="TextColor">#EEF2F6</Color>
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}"/>
    <Color x:Key="MutedColor">#8F9AA8</Color>
    <SolidColorBrush x:Key="MutedBrush" Color="{DynamicResource MutedColor}"/>
    <Color x:Key="LineColor">#2B3340</Color>
    <SolidColorBrush x:Key="LineBrush" Color="{DynamicResource LineColor}"/>
    <Color x:Key="AccentColor">#3B82F6</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}"/>
    <Color x:Key="PurpleColor">#3B82F6</Color>
    <SolidColorBrush x:Key="PurpleBrush" Color="{DynamicResource PurpleColor}"/>
    <Color x:Key="GreenColor">#10B981</Color>
    <SolidColorBrush x:Key="GreenBrush" Color="{DynamicResource GreenColor}"/>
    <Color x:Key="RedColor">#EF4444</Color>
    <SolidColorBrush x:Key="RedBrush" Color="{DynamicResource RedColor}"/>
    <Color x:Key="GridColor">#1B2028</Color>
    <SolidColorBrush x:Key="GridBrush" Color="{DynamicResource GridColor}"/>
    <SolidColorBrush x:Key="ChromeBrush" Color="#111419"/>
    <SolidColorBrush x:Key="ActiveSurfaceBrush" Color="#1E2B3D"/>
    <DrawingBrush x:Key="CanvasFieldBrush" TileMode="Tile" ViewportUnits="Absolute" ViewboxUnits="Absolute"
                  Viewport="0,0,18,18" Viewbox="0,0,18,18" Stretch="None">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#0B0D10" Geometry="M 0,0 L 18,0 18,18 0,18 Z"/>
                <GeometryDrawing Brush="#1B2028"><GeometryDrawing.Geometry>
                    <EllipseGeometry Center="1,1" RadiusX=".75" RadiusY=".75"/>
                </GeometryDrawing.Geometry></GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <SolidColorBrush x:Key="WorkSurfaceBrush" Color="#0B0D10"/>
    <SolidColorBrush x:Key="ToolRailBrush" Color="#161A21"/>
    <SolidColorBrush x:Key="DividerGripBrush" Color="#2B3340"/>
    <SolidColorBrush x:Key="ActionFillBrush" Color="#DCE9FA"/>
    <SolidColorBrush x:Key="ActionInkBrush" Color="#111419"/>
    <SolidColorBrush x:Key="TitleSurfaceBrush" Color="#111419"/>
    <SolidColorBrush x:Key="CommandDeckBrush" Color="#161A21"/>
    <SolidColorBrush x:Key="SimulationDeckBrush" Color="#161A21"/>
    <SolidColorBrush x:Key="ComboSurfaceBrush" Color="#1D222B"/>
    <SolidColorBrush x:Key="SubtleLineBrush" Color="#222832"/>
    <SolidColorBrush x:Key="PressedBrush" Color="#2C3442"/>
    <SolidColorBrush x:Key="SelectedBrush" Color="#1E2B3D"/>
    <SolidColorBrush x:Key="FaintBrush" Color="#5A6575"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#60A5FA"/>
    <SolidColorBrush x:Key="SuccessSurfaceBrush" Color="#122D25"/>
    <SolidColorBrush x:Key="DangerSurfaceBrush" Color="#351F24"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#2E3644"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#434F63"/>
    <SolidColorBrush x:Key="PreviewSurfaceBrush" Color="#E8EDF2"/>
    <SolidColorBrush x:Key="NavigationSurfaceBrush" Color="#0D1014"/>
    <SolidColorBrush x:Key="SuccessInkBrush" Color="#B9F6D9"/>
    <SolidColorBrush x:Key="DangerInkBrush" Color="#FFC0C0"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource GreenColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource RedColor}"/>
    <SolidColorBrush x:Key="CanvasHintBrush" Color="#D9161A21"/>
    <LinearGradientBrush x:Key="NavigationGlassShellBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#B83A527B" Offset="0"/>
        <GradientStop Color="#CC162540" Offset=".52"/>
        <GradientStop Color="#AC263C62" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="NavigationGlassHoverBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#DB42668F" Offset="0"/>
        <GradientStop Color="#DB1D3258" Offset=".54"/>
        <GradientStop Color="#D138527B" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="NavigationGlassActiveBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#ED4C6C9A" Offset="0"/>
        <GradientStop Color="#F2253D64" Offset=".52"/>
        <GradientStop Color="#E737547D" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="NavigationGlassGlintBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#005FB4FF" Offset=".10"/>
        <GradientStop Color="#A769BFFF" Offset=".40"/>
        <GradientStop Color="#FADCF5FF" Offset=".51"/>
        <GradientStop Color="#9469BFFF" Offset=".61"/>
        <GradientStop Color="#0069BFFF" Offset=".94"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="NavigationGlassLowerGlintBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#002A81FF" Offset=".18"/>
        <GradientStop Color="#963A94FF" Offset=".53"/>
        <GradientStop Color="#E9C2EEFF" Offset=".69"/>
        <GradientStop Color="#793F9DFF" Offset=".79"/>
        <GradientStop Color="#003F9DFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="NavigationGlassEdgeBrush" StartPoint="0,0" EndPoint=".24,1">
        <GradientStop Color="#A68CBAEA" Offset="0"/>
        <GradientStop Color="#5D587AAB" Offset=".56"/>
        <GradientStop Color="#A179A1D3" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="NavigationGlassInnerEdgeBrush" Color="#1FCCE6FF"/>
    <SolidColorBrush x:Key="NavigationGlassActiveEdgeBrush" Color="#BAAAD3F8"/>
</ResourceDictionary>
