<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="BackgroundColor">#EDF2F8</Color>
    <SolidColorBrush x:Key="BackgroundBrush" Color="{DynamicResource BackgroundColor}"/>
    <Color x:Key="PanelColor">#FCFFFFFF</Color>
    <SolidColorBrush x:Key="PanelBrush" Color="{DynamicResource PanelColor}"/>
    <Color x:Key="RaisedColor">#ECF0FA</Color>
    <SolidColorBrush x:Key="RaisedBrush" Color="{DynamicResource RaisedColor}"/>
    <Color x:Key="HoverColor">#E2EAFB</Color>
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}"/>
    <Color x:Key="TextColor">#17283F</Color>
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}"/>
    <Color x:Key="MutedColor">#526580</Color>
    <SolidColorBrush x:Key="MutedBrush" Color="{DynamicResource MutedColor}"/>
    <Color x:Key="LineColor">#CDD7EC</Color>
    <SolidColorBrush x:Key="LineBrush" Color="{DynamicResource LineColor}"/>
    <Color x:Key="AccentColor">#007E98</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}"/>
    <Color x:Key="PurpleColor">#6540CB</Color>
    <SolidColorBrush x:Key="PurpleBrush" Color="{DynamicResource PurpleColor}"/>
    <Color x:Key="GreenColor">#087B49</Color>
    <SolidColorBrush x:Key="GreenBrush" Color="{DynamicResource GreenColor}"/>
    <Color x:Key="RedColor">#C52648</Color>
    <SolidColorBrush x:Key="RedBrush" Color="{DynamicResource RedColor}"/>
    <Color x:Key="GridColor">#D9E3EF</Color>
    <SolidColorBrush x:Key="GridBrush" Color="{DynamicResource GridColor}"/>
    <SolidColorBrush x:Key="ChromeBrush" Color="#F5F7FD"/>
    <SolidColorBrush x:Key="ActiveSurfaceBrush" Color="#D8EEF3"/>
    <DrawingBrush x:Key="CanvasFieldBrush" TileMode="Tile" ViewportUnits="Absolute" ViewboxUnits="Absolute"
                  Viewport="0,0,18,18" Viewbox="0,0,18,18" Stretch="None">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#F7F9FE" Geometry="M 0,0 L 18,0 18,18 0,18 Z"/>
                <GeometryDrawing Brush="#BAC7E5"><GeometryDrawing.Geometry>
                    <EllipseGeometry Center="1,1" RadiusX=".72" RadiusY=".72"/>
                </GeometryDrawing.Geometry></GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <SolidColorBrush x:Key="WorkSurfaceBrush" Color="#F7F9FE"/>
    <SolidColorBrush x:Key="ToolRailBrush" Color="#E7EDFA"/>
    <SolidColorBrush x:Key="DividerGripBrush" Color="#F1F5FD"/>
    <SolidColorBrush x:Key="ActionFillBrush" Color="#5B3FB0"/>
    <SolidColorBrush x:Key="ActionInkBrush" Color="#FFFFFF"/>
    <LinearGradientBrush x:Key="TitleSurfaceBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#EFF0FF" Offset="0"/>
        <GradientStop Color="#F5F9FD" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CommandDeckBrush" Color="#DDE3EF"/>
    <SolidColorBrush x:Key="SimulationDeckBrush" Color="#E5DFFF"/>
    <SolidColorBrush x:Key="ComboSurfaceBrush" Color="#EDF2FC"/>
    <SolidColorBrush x:Key="SubtleLineBrush" Color="#DDE4F0"/>
    <SolidColorBrush x:Key="PressedBrush" Color="#CDD9EF"/>
    <SolidColorBrush x:Key="SelectedBrush" Color="#D6E3FC"/>
    <SolidColorBrush x:Key="FaintBrush" Color="#63718A"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#005CA7"/>
    <SolidColorBrush x:Key="SuccessSurfaceBrush" Color="#DBF4E7"/>
    <SolidColorBrush x:Key="DangerSurfaceBrush" Color="#FBE3E7"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#8C5000"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#A5B5D0"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#7D92B5"/>
    <SolidColorBrush x:Key="PreviewSurfaceBrush" Color="#F7F9FC"/>
    <SolidColorBrush x:Key="NavigationSurfaceBrush" Color="#E3EBF8"/>
    <SolidColorBrush x:Key="SuccessInkBrush" Color="#115D38"/>
    <SolidColorBrush x:Key="DangerInkBrush" Color="#A12437"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource GreenColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource RedColor}"/>
    <SolidColorBrush x:Key="CanvasHintBrush" Color="#EEF7F9FC"/>
    <LinearGradientBrush x:Key="NavigationGlassShellBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#EFFFFEFF" Offset="0"/>
        <GradientStop Color="#AD9DB9D2" Offset="0.45"/>
        <GradientStop Color="#75D9E5F3" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="NavigationGlassHoverBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#90FFFFFF" Offset="0"/>
        <GradientStop Color="#55A5BFD8" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="NavigationGlassActiveBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F6FFFFFF" Offset="0"/>
        <GradientStop Color="#E4D1E7FB" Offset="0.45"/>
        <GradientStop Color="#C4B1CDE7" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="NavigationGlassGlintBrush" StartPoint="0,0" EndPoint="0.3,1">
        <GradientStop Color="#EFFFFFFF" Offset="0"/>
        <GradientStop Color="#00FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="NavigationGlassEdgeBrush" Color="#996381A6"/>
    <SolidColorBrush x:Key="NavigationGlassInnerEdgeBrush" Color="#B0FFFFFF"/>
    <SolidColorBrush x:Key="NavigationGlassActiveEdgeBrush" Color="#A96384AC"/>
</ResourceDictionary>
